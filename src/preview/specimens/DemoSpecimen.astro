---
// Preview specimen for /preview/templates/demo/: the ① register demo on the register fixture, as
// its demo page renders it. The engine slot is DemoEngine (kind "register"), whose replay copies the
// transcript, so it replays whatever data the transcript shows; the transcript slot is
// RegisterTranscript, the demo's final state, which reads in full without JavaScript. The frame
// carries the fixture's declared provenance ("illustrative"), so it shows the "Illustrative data"
// label.
// Fixtures are imported statically (see src/preview/gallery.astro).
import DemoTemplate from "../../templates/DemoTemplate.astro";
import DemoEngine from "../../components/demo/DemoEngine.astro";
import RegisterTranscript from "../../components/demo/RegisterTranscript.astro";
import { demoFixture, fixtureSite } from "../../fixtures/index.ts";
import { refId, solutionLink } from "../../lib/site";
---
<DemoTemplate
  solution={solutionLink(fixtureSite, refId(demoFixture.solution))}
  demo={{ title: demoFixture.title, kind: demoFixture.kind, provenance: demoFixture.provenance }}
  report={null}
  site={fixtureSite}
>
  <DemoEngine slot="engine" kind="register" />
  <RegisterTranscript slot="transcript" data={demoFixture.data} />
</DemoTemplate>
