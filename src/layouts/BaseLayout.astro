---
import "../styles/global.css";
import archivoLatin from "@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url";
import SiteHeader from "../components/site/SiteHeader.astro";
import SiteFooter from "../components/site/SiteFooter.astro";
import { jsonLd } from "../lib/json-ld";

interface Props {
  title?: string;
  /**
   * The page's own meta description (spec §11.3: unique, 150–160 characters). Required, with no
   * default: a route passes pageDescription(entry) from src/lib/meta.ts (a post passes its own), so
   * no page falls back to shared copy.
   */
  description: string;
  /** Adds <meta name="robots" content="noindex"> (template previews; later, the 404). */
  noindex?: boolean;
}

const {
  title = "Techsider — Enterprise AI for Australian business",
  description,
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).toString();
// The Organization carries no description: the page's meta description describes the page, and
// would give the one organisation a different description on every page.
const organization = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Techsider",
  url: "https://techsider.com.au",
  email: "admin@techsider.com.au",
  areaServed: "AU",
  knowsAbout: ["LLM Ops", "Retrieval-Augmented Generation", "AI Agents"],
};
---

<!doctype html>
<html lang="en-AU" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>document.documentElement.classList.replace("no-js", "js");</script>
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0B0B0C" />
    <link rel="preload" as="font" type="font/woff2" href={archivoLatin} crossorigin />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="canonical" href={canonical} />

    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Techsider" />
    <meta property="og:image" content="https://techsider.com.au/og.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://techsider.com.au/og.png" />

    <script type="application/ld+json" set:html={jsonLd(organization)} />
  </head>
  <body class="bg-carbon text-bone font-sans antialiased">
    <a href="#main" class="skip-link">Skip to content</a>
    <SiteHeader />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
