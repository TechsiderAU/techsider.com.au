---
import "../styles/global.css";
import archivoLatin from "@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url";
import SiteHeader from "../components/site/SiteHeader.astro";
import SiteFooter from "../components/site/SiteFooter.astro";
import SocialImageMeta from "../components/site/SocialImageMeta.astro";
import { jsonLd, pageGraph, type JsonLdNode } from "../lib/json-ld";

interface Props {
  /** The page's own <title> (spec §11.3): a route passes pageTitle(entry) from src/lib/meta.ts, a post its own. */
  title: string;
  /**
   * The page's own meta description (spec §11.3: unique, 150–160 characters). Required, with no
   * default: a route passes pageDescription(entry) from src/lib/meta.ts (a post passes its own), so
   * no page falls back to shared copy.
   */
  description: string;
  /** Adds <meta name="robots" content="noindex"> (the template previews and the 404). */
  noindex?: boolean;
  /**
   * The canonical URL's path when another page owns this page's content: a route passes its nav
   * entry's canonicalPath (the ⑤ demo page's is /resources/what-you-already-pay-for/, spec §8.8).
   * <link rel="canonical"> and og:url use it; without it, both are the page's own URL. null: the
   * page has no URL of its own, so neither renders. The 404 passes null: GitHub Pages serves it at
   * every address it has no file for (the Phase C review's T1-F1).
   */
  canonicalPath?: string | null;
  /**
   * The page's own JSON-LD nodes (spec §11.3), which follow the Organization in the page's @graph:
   * a Service on a solution or service page, a BlogPosting on a post. src/lib/json-ld.ts builds them.
   */
  graph?: JsonLdNode[];
}

const { title, description, noindex = false, canonicalPath, graph = [] } = Astro.props;

const site = Astro.site ?? Astro.url;
const canonical = canonicalPath === null ? null : new URL(canonicalPath ?? Astro.url.pathname, site).toString();
// One @graph per page: the Organization (in full, with the WebSite, on Home), then the route's nodes.
// src/lib/json-ld.ts says what each node carries, and why the Organization has no description.
const structuredData = pageGraph(site, Astro.url.pathname, graph);
---

<!doctype html>
<html lang="en-AU" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>document.documentElement.classList.replace("no-js", "js");</script>
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0B0B0C" />
    <link rel="preload" as="font" type="font/woff2" href={archivoLatin} crossorigin />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    {canonical !== null && <link rel="canonical" href={canonical} />}

    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical !== null && <meta property="og:url" content={canonical} />}
    <meta property="og:site_name" content="Techsider" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <SocialImageMeta />

    <script type="application/ld+json" set:html={jsonLd(structuredData)} />
  </head>
  <body class="bg-carbon text-bone font-sans antialiased">
    <a href="#main" class="skip-link">Skip to content</a>
    <SiteHeader />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
