---
// An insight post (spec §8.9), restyled in Phase B2. A carbon PageHero: the breadcrumb (Home ›
// Insights › the post), the type as a bracket eyebrow, the title as a sentence-case H1, then the
// meta line (date, "Updated {date}", reading time). Then, on bone: the industry chips, the markdown
// body in Prose, and the §10.1 contextual closing prompt, set inside the reading column, so no
// band sits above the footer. The route builds the PostView (src/lib/views/post.ts); this layout
// is markup over it. JSON-LD: BlogPosting, authored and published by the Organization (§11.3).
// An illustrative post carries data-provenance="illustrative" and its label (§9.3, CI check 06).
import BaseLayout from "./BaseLayout.astro";
import PageHero from "../components/page/PageHero.astro";
import ChipRow from "../components/page/ChipRow.astro";
import Prose from "../components/page/Prose.astro";
import PromptBlock from "../components/ui/PromptBlock.astro";
import { jsonLd } from "../lib/json-ld";
import type { PostView } from "../lib/views/post";

interface Props {
  view: PostView;
}

const { view } = Astro.props;
const { card, closing } = view;
// Content dates are calendar dates, parsed as UTC midnight, so they are shown in UTC.
const isoDate = (d: Date) => d.toISOString().slice(0, 10);
const shownDate = (d: Date) => d.toLocaleDateString("en-AU", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" });
---
<BaseLayout title={view.metaTitle} description={card.description}>
  <article class="post" data-post data-provenance={view.illustrativeLabel ? "illustrative" : undefined}>
    <PageHero title={card.title} display={false} eyebrow={card.typeLabel.toLowerCase()} breadcrumb={view.breadcrumb}>
      <p class="post-meta" data-post-meta><time datetime={isoDate(card.date)}>{shownDate(card.date)}</time>{view.updated && <Fragment> · Updated <time datetime={isoDate(view.updated)}>{shownDate(view.updated)}</time></Fragment>} · {card.minutes} min read</p>
      {view.illustrativeLabel && <p class="post-illustrative" data-illustrative-label>{view.illustrativeLabel}</p>}
    </PageHero>
    <div class="post-body surface-bone" data-surface="bone">
      <div class="post-column">
        {card.industries.length > 0 && <ChipRow id="post-industries" label="Industries" chips={card.industries} />}
        <Prose><slot /></Prose>
        <div class="post-closing" data-post-closing>
          <PromptBlock command={closing.command} args={closing.args} label={closing.label} href={closing.href} />
        </div>
      </div>
    </div>
  </article>
  <script type="application/ld+json" set:html={jsonLd(view.jsonLd)} />
</BaseLayout>

<style>
  .post-meta,
  .post-illustrative {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--color-muted);
  }
  .post-illustrative {
    color: var(--color-bone);
  }
  .post-body {
    padding-block: 3rem 4rem;
  }
  @media (min-width: 64rem) {
    .post-body {
      padding-block: 4rem 6rem;
    }
  }
  /* The reading column: the 80rem container's left edge (aligned with the hero), 48rem wide. */
  .post-column {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    max-width: 80rem;
    margin-inline: auto;
    padding-inline: 1rem;
  }
  @media (min-width: 40rem) {
    .post-column {
      padding-inline: 1.5rem;
    }
  }
  .post-column > :global(*) {
    width: 100%;
    max-width: 48rem;
  }
  .post-closing {
    padding-top: 2.5rem;
    border-top: 1px solid var(--color-bone-line);
  }
  /* A contextual label ("Talk to us about AI for legal & professional") wraps inside the prompt
     block at 320px instead of overflowing it: the global .btn is nowrap. */
  .post-closing :global(.btn) {
    max-width: 100%;
    padding-block: 0.5rem;
    line-height: 1.3;
    text-align: center;
    white-space: normal;
  }
</style>
