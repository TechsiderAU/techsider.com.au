---
// Layout for the template-preview gallery only (src/preview/gallery.astro, a route that exists
// only in preview builds). Every page it wraps renders fictional fixture data, so it is noindex
// and opens with a banner saying so, then an "All previews" link back to the gallery index.
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title: string;
}

const { title } = Astro.props;
---
<BaseLayout
  title={`${title} | Template preview | Techsider`}
  description="Internal template preview. Every name, figure and document on this page is fictional fixture data."
  noindex
>
  <p class="preview-banner" data-fixture>Template preview — fictional fixture data</p>
  <p class="preview-all"><a href="/preview/" class="preview-all-link">All previews</a></p>
  <slot />
</BaseLayout>

<style>
  .preview-banner {
    margin: 0;
    padding: 0.625rem 1rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    text-align: center;
    color: var(--color-bone);
    background: var(--color-graphite);
  }
  .preview-all {
    margin: 0;
    padding: 0 1rem;
    text-align: center;
    background: var(--color-graphite);
  }
  .preview-all-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-bone);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .preview-all-link:hover {
    color: var(--color-acid);
  }
</style>
