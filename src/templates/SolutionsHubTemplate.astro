---
// The Solutions hub (spec §8.2), body only: a Phase C route loads the five solutions, calls
// solutionsHubView() and wraps this in BaseLayout. A hero with no CTA; one switcher with three
// views (By job, By industry, By buyer), stacked sections without JavaScript; the closing prompt.
// Every link comes from the view: a null href renders as plain text, never as a dead link.
import { solutionArtwork } from "../lib/marketing";
import PageHero from "../components/page/PageHero.astro";
import PageSection from "../components/page/PageSection.astro";
import LinkCard from "../components/page/LinkCard.astro";
import BracketChip from "../components/ui/BracketChip.astro";
import DataTable from "../components/ui/DataTable.astro";
import PromptBlock from "../components/ui/PromptBlock.astro";
import Tabs from "../components/ui/Tabs.astro";
import TabPanel from "../components/ui/TabPanel.astro";
import type { BuyerItem, SolutionsHubView } from "../lib/views/hubs";

interface Props {
  view: SolutionsHubView;
}

const { view } = Astro.props;
// "By buyer": the mid-market packages beside the enterprise and government ones (spec §8.2).
const buyerLists: { id: string; title: string; items: BuyerItem[] }[] = [
  { id: "buyer-mid-market", title: "Mid-market packages", items: view.byBuyer.midMarket },
  { id: "buyer-enterprise", title: "Enterprise and government", items: view.byBuyer.enterprise },
];
---
<div class="template" data-template="solutions-hub">
  <PageHero title="AI solutions for the work that matters." display={false} art="hero" eyebrow="Our solutions" sub="Automate workflows, understand documents and make your knowledge easier to use. Built around your systems, with people in control." />

  <PageSection id="browse" title="Browse solutions">
    <Tabs id="solutions-switcher" label="Browse solutions">
      <TabPanel id="by-job" label="By job">
        <ul class="hub-jobs">
          {view.jobs.map((job) => (
            <li class="hub-job">
              <LinkCard title={`${job.number} ${job.shortName}`} href={job.href} body={job.oneLiner} art={["①", "②", "③"].includes(job.number) ? solutionArtwork(job.number) : undefined} level={4} />
            </li>
          ))}
        </ul>
      </TabPanel>
      <TabPanel id="by-industry" label="By industry">
        <DataTable
          caption={view.matrix.caption}
          columns={view.matrix.columns}
          rows={view.matrix.rows}
          rowHeader={view.matrix.rowHeader}
          rowIds={view.matrix.rowIds}
          rowMarker="data-matrix-row"
        />
      </TabPanel>
      <TabPanel id="by-buyer" label="By buyer">
        <div class="buyer-lists">
          {buyerLists.filter((list) => list.items.length > 0).map((list) => (
            <div class="buyer-list" data-buyer-list={list.id}>
              <h4 id={`${list.id}-heading`} class="buyer-list-title">{list.title}</h4>
              <ul class="buyer-items" aria-labelledby={`${list.id}-heading`}>
                {list.items.map((item) => (
                  <li class="buyer-item" data-package-status="launch">
                    {item.href ? <a href={item.href} class="hub-link">{item.name}</a> : <span class="buyer-item-name">{item.name}</span>}
                    <BracketChip label={`${item.solution.number} ${item.solution.shortName}`} />
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
        {view.servicesHref && (
          <p class="hub-more">
            <a href={view.servicesHref} class="hub-link">How engagements run <span aria-hidden="true">→</span></a>
          </p>
        )}
      </TabPanel>
    </Tabs>
  </PageSection>

  <div id="contact" class="template-closing">
    <PromptBlock title="Start with one workflow." command={view.closing.command} args={view.closing.args} label={view.closing.label} href={view.closing.href} />
  </div>
</div>

<style>
  /* Every block but the closing sits on bone: carbon text, bone-line hairlines, muted-dark
     secondary text (spec §6.1). Layout only; colours are tokens. */
  .hub-jobs {
    display: grid;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 40rem) {
    .hub-jobs {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 64rem) {
    .hub-jobs {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .hub-job {
    display: flex;
    min-width: 0;
  }
  .hub-job > :global(*) {
    flex: 1;
  }
  .buyer-lists {
    display: grid;
    gap: 2rem;
  }
  @media (min-width: 48rem) {
    .buyer-lists {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .buyer-list-title {
    margin: 0 0 0.5rem;
    font-size: 1.0625rem;
    font-weight: 600;
  }
  .buyer-items {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-bone-line);
  }
  .buyer-item {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 0.75rem;
    min-width: 0;
    padding-block: 0.375rem;
    border-bottom: 1px solid var(--color-bone-line);
    overflow-wrap: anywhere;
  }
  .buyer-item-name {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  .hub-more {
    margin: 1.5rem 0 0;
  }
  .hub-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 44px;
    color: inherit;
    text-decoration: underline;
    text-decoration-color: var(--color-muted-dark);
    text-underline-offset: 3px;
    overflow-wrap: anywhere;
  }
  .hub-link:hover {
    text-decoration-color: currentColor;
    text-decoration-thickness: 2px;
  }
  /* The closing prompt sits inside the content width, with normal section spacing above the
     footer: never a full-width band (spec §6.4). */
  .template-closing {
    max-width: 80rem;
    margin-inline: auto;
    padding: 4rem 1rem;
  }
  @media (min-width: 40rem) {
    .template-closing {
      padding-inline: 1.5rem;
    }
  }
  @media (min-width: 64rem) {
    .template-closing {
      padding-block: 6rem;
    }
  }
</style>
