---
// Concise business introduction. Detailed demonstrations and delivery evidence live on their own pages.
import PageHero from "../components/page/PageHero.astro";
import PageSection from "../components/page/PageSection.astro";
import BusinessArtwork from "../components/page/BusinessArtwork.astro";
import LinkCard from "../components/page/LinkCard.astro";
import InsightCard from "../components/page/InsightCard.astro";
import FaqList from "../components/ui/FaqList.astro";
import PromptBlock from "../components/ui/PromptBlock.astro";
import { AUTOMATION } from "../lib/marketing";
import type { HomeView } from "../lib/views/home";
interface Props { view: HomeView; }
const { view } = Astro.props;
const capabilities = AUTOMATION.capabilities.map(c => ({...c, solution: view.solutions.find(s => s.number === c.number)}));
const supporting = view.solutions.filter(s => s.number === "④" || s.number === "⑤");
---
<div class="template" data-template="home">
  <PageHero title={AUTOMATION.title} display={false} eyebrow="AI automation for Australian organisations" sub={AUTOMATION.sub} art="hero" ctas={{primary: {label: "Talk about your workflow", href: view.hero.ctas.primary.href}, secondary: {label: "Explore solutions", href: "#services"}}} />

  <div class="home-principles surface-bone" aria-label="How we build">
    <div><span>Connected systems</span><span>Human approvals</span><span>Ongoing support</span></div>
  </div>

  <PageSection id="services" title="Make everyday work flow." lede="Practical AI automation, built around your team and the tools you use.">
    <ul class="home-capabilities">
      {capabilities.map(c => <li class="capability" data-capability={c.art}>
        <BusinessArtwork kind={c.art} />
        <LinkCard title={c.title} body={c.body} href={c.solution?.href ?? null} />
      </li>)}
    </ul>
    <div class="home-supporting"><p>Already using AI? We can help you test it or put it to work.</p><div>{supporting.map(s => s.href ? <a href={s.href}>{s.shortName} <span aria-hidden="true">↗</span></a> : <span>{s.shortName}</span>)}</div></div>
  </PageSection>

  <PageSection id="approach" title="From one workflow to everyday impact.">
    <ol class="home-process">
      {AUTOMATION.process.map((step, i) => <li><span class="step-number">0{i + 1}</span><h3>{step.title}</h3><p>{step.body}</p></li>)}
    </ol>
    {view.servicesHref && <a class="home-link" href={view.servicesHref}>How we work <span aria-hidden="true">→</span></a>}
  </PageSection>

  <PageSection id="demo" title="See the possibilities." surface="carbon">
    <div class="home-example">
      <div><p class="example-label">Illustrative examples</p><h3>Less manual handling. Clearer decisions.</h3><p>Explore document extraction, answers with sources, and drafts that wait for approval.</p>{view.demo.allHref && <a class="btn btn-primary" href={view.demo.allHref} data-all-demos>Explore the demos <span aria-hidden="true">→</span></a>}</div>
      <BusinessArtwork kind="workflow" />
    </div>
  </PageSection>

  <PageSection id="industries" title="Built around your industry." lede="Workflows shaped by your systems, documents and operating requirements.">
    <ul class="home-industries">
      {view.industries.map(industry => <li><LinkCard title={industry.shortName} href={industry.href} body={AUTOMATION.industries[industry.shortName] ?? "AI workflows for your team."} /></li>)}
    </ul>
  </PageSection>

  <PageSection id="insights" title="Ideas for putting AI to work.">
    <div data-latest-insights={view.insights.mode}>
      {view.insights.mode === "cards" && <ul class="home-insights">{view.insights.cards.map(card => <li><InsightCard card={card} level={3} /></li>)}</ul>}
      {view.insights.allHref && <a class="home-link" href={view.insights.allHref} data-all-insights>All insights <span aria-hidden="true">→</span></a>}
    </div>
  </PageSection>

  <PageSection id="faq" title="A few practical questions." width="prose"><FaqList items={view.faq} /></PageSection>
  <div id="contact" class="template-closing"><PromptBlock title="What could your team stop doing manually?" command={view.closing.command} args={view.closing.args} label="Let's talk" href={view.closing.href} /></div>
</div>
<style>
  .home-principles { border-bottom: 1px solid var(--color-bone-line); }
  .home-principles > div { max-width: 80rem; margin: auto; display: flex; flex-wrap: wrap; gap: 1rem 2.5rem; padding: 1.25rem 1.5rem; font-size: .875rem; font-weight: 500; }
  .home-principles span::before { content: "✓"; margin-right: .6rem; color: var(--color-acid-deep); }
  .home-capabilities, .home-industries, .home-insights, .home-process { display: grid; gap: 1.5rem; list-style: none; margin: 0; padding: 0; }
  .capability { display: flex; flex-direction: column; gap: 1rem; min-width: 0; }
  .capability :global(.link-card) { flex: 1; border: 0; padding: 0 .125rem; overflow: visible; }
  .capability :global(.link-card::before) { display: none; }
  .capability :global(.link-card-link) { text-decoration: none; font-size: 1.45rem; }
  .capability :global(.link-card-link:hover) { text-decoration: underline; }
  .home-supporting { display: flex; flex-wrap: wrap; gap: .5rem 2rem; align-items: center; justify-content: space-between; padding-top: 1.5rem; border-top: 1px solid var(--color-bone-line); }
  .home-supporting p { margin: 0; color: var(--color-muted-dark); }
  .home-supporting > div { display: flex; flex-wrap: wrap; gap: 1.5rem; }
  .home-supporting a, .home-link { display: inline-flex; align-items: center; min-height: 44px; gap: .5rem; text-underline-offset: 4px; }
  .home-process li { border-top: 1px solid var(--color-bone-line); padding-top: 1.25rem; }
  .step-number { font-family: var(--font-mono); font-size: .875rem; color: var(--color-acid-deep); }
  .home-process h3 { margin: 1rem 0 .5rem; font-size: 1.4rem; font-weight: 600; letter-spacing: -.025em; }
  .home-process p { margin: 0; max-width: 38ch; color: var(--color-muted-dark); line-height: 1.6; }
  .home-example { display: grid; align-items: center; gap: 2rem; }
  .home-example h3 { margin: 0 0 1rem; max-width: 20ch; font-size: clamp(1.75rem, 1.25rem + 2vw, 2.75rem); letter-spacing: -.035em; font-weight: 600; line-height: 1.1; }
  .home-example p { max-width: 42ch; margin-bottom: 1.5rem; color: var(--color-muted); }
  .home-example .example-label { font-size: .8125rem; text-transform: uppercase; letter-spacing: .075em; }
  .home-example :global(figcaption) { color: var(--color-muted); }
  .home-industries > li, .home-insights > li { display: flex; min-width: 0; }
  .home-industries :global(.link-card), .home-insights :global(.insight-card) { flex: 1; }
  .template-closing { max-width: 80rem; margin: auto; padding: 4rem 1rem; }
  @media (min-width: 40rem) { .home-industries, .home-insights { grid-template-columns: repeat(2,minmax(0,1fr)); } .template-closing { padding-inline: 1.5rem; } }
  @media (min-width: 64rem) { .home-capabilities, .home-industries, .home-insights, .home-process { grid-template-columns: repeat(3,minmax(0,1fr)); } .home-example { grid-template-columns: minmax(0,.85fr) minmax(0,1.15fr); gap: 3rem; } .template-closing { padding-block: 6rem; } }
</style>
