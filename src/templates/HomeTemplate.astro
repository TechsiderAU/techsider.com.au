---
import PageHero from "../components/page/PageHero.astro";
import PageSection from "../components/page/PageSection.astro";
import LinkCard from "../components/page/LinkCard.astro";
import FaqList from "../components/ui/FaqList.astro";
import PromptBlock from "../components/ui/PromptBlock.astro";
import { AUTOMATION } from "../lib/marketing";
import type { HomeView } from "../lib/views/home";
interface Props { view: HomeView; }
const { view } = Astro.props;
const capabilities = AUTOMATION.capabilities.map(c => ({ ...c, solution: view.solutions.find(s => s.number === c.number) }));

---
<div class="template" data-template="home">
  <PageHero title={AUTOMATION.title} display={false} eyebrow="AI automation for Australian businesses" sub={AUTOMATION.sub} art="hero" ctas={{ primary: { label: "Start with one workflow", href: view.hero.ctas.primary.href }, secondary: { label: "See an example", href: view.demo.allHref ?? "#demo" } }} />
  <PageSection id="services" title="Put repetitive work on a clearer path.">
    <ul class="home-capabilities">{capabilities.map(c => <li class="capability" data-capability={c.art}><LinkCard title={c.title} body={c.body} href={c.solution?.href ?? null} /></li>)}</ul>
    <div class="home-supporting"><p>Already using AI? We can help you put existing tools to work or evaluate a system built elsewhere.</p><div><a href={view.solutions.find(s => s.number === "⑤")?.href ?? view.closing.href}>AI in your existing software</a><a href={view.solutions.find(s => s.number === "④")?.href ?? view.closing.href}>Independent AI evaluation</a></div></div>
  </PageSection>
  <PageSection id="approach" title="Start small. Prove it. Build from there.">
    <ol class="home-process">{AUTOMATION.process.map((step, i) => <li><span class="step-number">0{i + 1}</span><h3>{step.title}</h3><p>{step.body}</p></li>)}</ol>
    {view.servicesHref && <a class="home-link" href={view.servicesHref}>How we work <span aria-hidden="true">→</span></a>}
  </PageSection>
  <PageSection id="demo" title="A document arrives. Your team gets work ready for review." surface="carbon">
    <div class="home-example"><div><p class="example-label">Illustrative workflow</p><p>An illustrative workflow reads a document, extracts agreed details and flags missing information. A person checks the result before the next step.</p><a class="btn btn-primary" href={view.documentDemoHref ?? view.demo.allHref ?? "#services"} data-all-demos>See the document example</a></div><ol class="example-flow" aria-label="Document workflow"><li>Receive</li><li>Extract</li><li>Check</li><li>Review</li><li>Prepare handoff</li></ol></div>
  </PageSection>
  <PageSection id="faq" title="Practical automation, with clear responsibility.">
    <ul class="home-process"><li><h3>Tested on your work</h3><p>Agree what a useful result looks like, then check it against known examples.</p></li><li><h3>People stay in control</h3><p>Make review, approvals and exception handling part of the workflow.</p></li><li><h3>A clear handover</h3><p>Document how to operate the system and who is responsible for each step.</p></li></ul>
    <p><a class="home-link" href="/resources/evaluation-method/">Read our evaluation method</a></p>
    {view.trustHref && <a class="home-link" href={view.trustHref}>Trust and data handling</a>}
    <FaqList items={view.faq} />
    <p><a id="industries" class="home-link" href={view.industriesHref ?? "#services"}>Explore your industry</a> · <a id="insights" class="home-link" href={view.resourcesHref ?? "#services"}>Resources and insights</a></p>
  </PageSection>
  <div id="contact" class="template-closing"><PromptBlock title="What could your team stop doing manually?" body="Tell us about one process that takes too much handling. We’ll discuss whether your existing tools or a scoped automation could help." command={view.closing.command} label="Start with one workflow" href={view.closing.href} /></div>
</div>
<style>
  .example-flow { margin: 0; padding: 0; list-style: none; display: grid; gap: .5rem; }
  .example-flow li { padding: .8rem 1rem; border: 1px solid var(--color-graphite); border-radius: 6px; }
  .example-flow li:nth-child(4) { border-color: var(--color-acid); color: var(--color-acid); }
  .home-principles { border-bottom: 1px solid var(--color-bone-line); }
  .home-principles > div { max-width: 80rem; margin: auto; display: flex; flex-wrap: wrap; gap: 1rem 2.5rem; padding: 1.25rem 1.5rem; font-size: .875rem; font-weight: 500; }
  .home-principles span::before { content: "✓"; margin-right: .6rem; color: var(--color-acid-deep); }
  .home-capabilities, .home-industries, .home-insights, .home-process { display: grid; gap: 1.5rem; list-style: none; margin: 0; padding: 0; }
  .capability { display: flex; flex-direction: column; gap: 1rem; min-width: 0; }
  .capability :global(.link-card) { flex: 1; border: 0; padding: 0 .125rem; overflow: visible; }
  .capability :global(.link-card::before) { display: none; }
  .capability :global(.link-card-link) { text-decoration: none; font-size: 1.45rem; }
  .capability :global(.link-card-link:hover) { text-decoration: underline; }
  .home-supporting { display: flex; flex-wrap: wrap; gap: .5rem 2rem; align-items: center; justify-content: space-between; padding-top: 1.5rem; border-top: 1px solid var(--color-bone-line); }
  .home-supporting p { margin: 0; color: var(--color-muted-dark); }
  .home-supporting > div { display: flex; flex-wrap: wrap; gap: 1.5rem; }
  .home-supporting a, .home-link { display: inline-flex; align-items: center; min-height: 44px; gap: .5rem; text-underline-offset: 4px; }
  .home-process li { border-top: 1px solid var(--color-bone-line); padding-top: 1.25rem; }
  .step-number { font-family: var(--font-mono); font-size: .875rem; color: var(--color-acid-deep); }
  .home-process h3 { margin: 1rem 0 .5rem; font-size: 1.4rem; font-weight: 600; letter-spacing: -.025em; }
  .home-process p { margin: 0; max-width: 38ch; color: var(--color-muted-dark); line-height: 1.6; }
  .home-example { display: grid; align-items: center; gap: 2rem; }
  .home-example h3 { margin: 0 0 1rem; max-width: 20ch; font-size: clamp(1.75rem, 1.25rem + 2vw, 2.75rem); letter-spacing: -.035em; font-weight: 600; line-height: 1.1; }
  .home-example p { max-width: 42ch; margin-bottom: 1.5rem; color: var(--color-muted); }
  .home-example .example-label { font-size: .8125rem; text-transform: uppercase; letter-spacing: .075em; }
  .home-example :global(figcaption) { color: var(--color-muted); }
  .home-industries > li, .home-insights > li { display: flex; min-width: 0; }
  .home-industries :global(.link-card), .home-insights :global(.insight-card) { flex: 1; }
  .template-closing { max-width: 80rem; margin: auto; padding: 4rem 1rem; }
  @media (min-width: 40rem) { .home-industries, .home-insights { grid-template-columns: repeat(2,minmax(0,1fr)); } .template-closing { padding-inline: 1.5rem; } }
  @media (min-width: 64rem) { .home-capabilities, .home-industries, .home-insights, .home-process { grid-template-columns: repeat(3,minmax(0,1fr)); } .home-example { grid-template-columns: minmax(0,.85fr) minmax(0,1.15fr); gap: 3rem; } .template-closing { padding-block: 6rem; } }
</style>
