---
// The Legal hub (spec §8.11), body only: a Phase C route loads the legal documents that exist
// (the documents collection, less the evaluation method and drafts), maps each to its page's
// href from the SiteContext and wraps this in BaseLayout. One card per document whose page is
// shown, and nothing for any other (spec §8.11, §7.1): no placeholder, no "coming soon", and no
// card for a document whose page isn't shown yet (a null href). With no document shown the hub
// has nothing to list, so legalHubDocs() fails the build instead of rendering an empty section.
import PageHero from "../components/page/PageHero.astro";
import PageSection from "../components/page/PageSection.astro";
import LinkCard from "../components/page/LinkCard.astro";
import { formatDate } from "../lib/dates";
import type { SiteContext } from "../lib/site";
import { legalHubDocs, type LegalDoc } from "../lib/views/company";

interface Props {
  docs: LegalDoc[];
  site: SiteContext;
}

const { docs } = Astro.props;
const shown = legalHubDocs(docs);
---
<div class="template" data-template="legal-hub">
  <PageHero title="Legal." highlight="Legal" />

  <PageSection id="documents" title="Documents">
    <ul class="legal-docs">
      {shown.map((doc) => (
        <li class="legal-doc" data-legal-doc>
          <LinkCard title={doc.title} href={doc.href} body={doc.summary} meta={`Last updated ${formatDate(doc.lastUpdated)}`} />
        </li>
      ))}
    </ul>
  </PageSection>
</div>

<style>
  .legal-docs {
    display: grid;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 48rem) {
    .legal-docs {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .legal-doc {
    display: flex;
    min-width: 0;
  }
  .legal-doc > :global(*) {
    flex: 1;
  }
</style>
