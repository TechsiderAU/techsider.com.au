---
// Evaluation method (spec §8.7, §9.1, §9.2). Body only: a Phase C route loads the
// `evaluation-method` document, renders its markdown body into the default slot, passes the ④
// sample report and the harness URL, and renders this inside BaseLayout.
// - #method: the published method, in Prose.
// - #sample-report: SampleReport, whose fixed caption can't be switched off.
// - #harness: rendered only once the harness is published (spec §12 item 4). Until then
//   harnessUrl is null and the page has no harness block and no harness link.
import PageHero from "../components/page/PageHero.astro";
import PageSection from "../components/page/PageSection.astro";
import Prose from "../components/page/Prose.astro";
import PromptBlock from "../components/ui/PromptBlock.astro";
import SampleReport from "../components/ui/SampleReport.astro";
import type { SampleReportData } from "../content/schemas";
import type { DocumentData } from "../content/page-schemas";
import { crumbs, type SiteContext } from "../lib/site";

interface Props {
  doc: DocumentData;
  report: SampleReportData;
  harnessUrl: string | null;
  site: SiteContext;
}

const { doc, report, harnessUrl, site } = Astro.props;
const evaluation = site.solutions[3];

// Content dates are UTC midnights ("2026-09-10"), so they print in UTC: "10 September 2026".
const formatDate = (d: Date) => d.toLocaleDateString("en-AU", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" });
const isoDate = (d: Date) => d.toISOString().slice(0, 10);
---
<div class="template" data-template="evaluation-method">
  <PageHero
    title={doc.title}
    display={false}
    eyebrow="resources"
    sub={doc.summary}
    breadcrumb={crumbs(site, ["resources", "evaluationMethod"])}
  >
    <p class="method-updated" data-last-updated>Last updated <time datetime={isoDate(doc.lastUpdated)}>{formatDate(doc.lastUpdated)}</time></p>
  </PageHero>

  <PageSection id="method" title="The method" width="prose">
    <Prose><slot /></Prose>
  </PageSection>

  <PageSection id="sample-report" title="The sample report">
    <SampleReport report={report} />
  </PageSection>

  {harnessUrl !== null && (
    <PageSection id="harness" title="The harness" width="prose">
      <p class="method-harness"><a href={harnessUrl} class="method-harness-link" data-harness-link>{harnessUrl.replace(/^https?:\/\//, "")}</a></p>
    </PageSection>
  )}

  <section id="contact" class="method-closing">
    <PromptBlock
      command="talk_to_us"
      args={`--about=${evaluation.id}`}
      label={`Talk to us about ${evaluation.shortName}`}
      href={site.contact({ interest: evaluation.id })}
    />
  </section>
</div>

<style>
  .method-updated {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--color-muted);
  }
  .method-harness {
    margin: 0;
  }
  .method-harness-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-family: var(--font-mono);
    color: var(--color-carbon);
    text-decoration: underline;
    text-decoration-color: var(--color-muted-dark);
    text-underline-offset: 3px;
    overflow-wrap: anywhere;
  }
  .method-harness-link:hover {
    text-decoration-color: currentColor;
    text-decoration-thickness: 2px;
  }
  /* The closing prompt sits inside the content width on carbon, a normal section's space above
     the footer: never a full-width band (spec §6.4). */
  .method-closing {
    padding: 4rem 1rem;
  }
  @media (min-width: 64rem) {
    .method-closing {
      padding-block: 6rem;
    }
  }
  /* "Talk to us about {solution}" is longer than .btn's one line allows at 320px (global.css
     sets white-space: nowrap): let it wrap. */
  [data-template="evaluation-method"] :global(.btn) {
    padding-block: 0.5rem;
    white-space: normal;
    text-align: center;
  }
</style>
