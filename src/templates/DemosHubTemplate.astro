---
// Demos hub (spec §7.1 /demos/, §8.8). Body only: a Phase D route loads the demos collection,
// passes { solutionId, title, kind } per demo and siteContext(isPreview()), and renders this
// inside BaseLayout. One LinkCard per demo, badged by its kind: the ⑤ checker is a live
// client-side tool, not a replay, so it carries the checker badge; the ④ demo is a sample report,
// so it carries the report badge (ledger ruling R4); the replays carry the canned-replay badge.
// The badges are per card only: a page-wide replay badge in the hero would mislabel ④ and ⑤.
import PageHero from "../components/page/PageHero.astro";
import PageSection from "../components/page/PageSection.astro";
import LinkCard from "../components/page/LinkCard.astro";
import PromptBlock from "../components/ui/PromptBlock.astro";
import type { DemoKind } from "../content/schemas";
import { CHECKER_BADGE, DEMO_BADGE, REPORT_BADGE } from "../lib/fixed-copy";
import { crumbs, solutionLink, type SiteContext } from "../lib/site";

interface Props {
  demos: { solutionId: string; title: string; kind: DemoKind }[];
  site: SiteContext;
}

const { demos, site } = Astro.props;
const cards = demos.map((d) => {
  const solution = solutionLink(site, d.solutionId);
  return {
    kind: d.kind,
    eyebrow: `${solution.number} ${solution.shortName}`,
    title: d.title,
    badge: d.kind === "checker" ? CHECKER_BADGE : d.kind === "report" ? REPORT_BADGE : DEMO_BADGE,
    href: site.demo(d.solutionId),
  };
});
---
<div class="template" data-template="demos-hub">
  <PageHero title="Demos." highlight="Demos" sub={site.page("demos").oneLiner} breadcrumb={crumbs(site, ["demos"])} />

  <PageSection id="demos" title="The demos">
    <ul class="demos-grid">
      {cards.map((card) => (
        <li data-demo-kind={card.kind}>
          <LinkCard title={card.title} eyebrow={card.eyebrow} meta={card.badge} href={card.href} />
        </li>
      ))}
    </ul>
  </PageSection>

  <section id="contact" class="demos-closing">
    <PromptBlock command="talk_to_us" label="Talk to us" href={site.contact()} />
  </section>
</div>

<style>
  .demos-grid {
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 48rem) {
    .demos-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 64rem) {
    .demos-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .demos-grid > li {
    display: grid;
    min-width: 0;
  }
  /* The closing prompt sits inside the content width on carbon, a normal section's space above
     the footer: never a full-width band (spec §6.4). */
  .demos-closing {
    padding: 4rem 1rem;
  }
  @media (min-width: 64rem) {
    .demos-closing {
      padding-block: 6rem;
    }
  }
</style>
