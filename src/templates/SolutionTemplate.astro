---
// Solution page body (spec §8.3), rendered from a SolutionView (src/lib/views/solution.ts).
// Phase C's /solutions/<slug>/ route builds the view and wraps this in BaseLayout; in B2 only the
// preview gallery renders it. Named slot "demo": the solution's demo (or, on ④, the sample
// report), shown in an expandable example below the introduction.
// Package markup is CI check 10's contract: the generic package is the first full block, launch
// packages are tabs whose panel ids are the package ids (so #<package-id> selects one), on-request
// packages are one-line entries, and internal packages never reach the view.
import { SOLUTION_LABELS } from "../data/nav";
import { SOLUTION_GUIDES } from "../lib/marketing";
import PageHero from "../components/page/PageHero.astro";
import PageSection from "../components/page/PageSection.astro";
import ChipRow from "../components/page/ChipRow.astro";
import LinkCard from "../components/page/LinkCard.astro";
import PackageBlock from "../components/page/PackageBlock.astro";
import BracketChip from "../components/ui/BracketChip.astro";
import Tabs from "../components/ui/Tabs.astro";
import TabPanel from "../components/ui/TabPanel.astro";
import FaqList from "../components/ui/FaqList.astro";
import PromptBlock from "../components/ui/PromptBlock.astro";
import { ACCEPTANCE_TEST_LABEL } from "../lib/fixed-copy.ts";
import type { SolutionView } from "../lib/views/solution.ts";

interface Props {
  view: SolutionView;
}

const { view } = Astro.props;
// A page without an example renders no disclosure. Examples retain their full transcripts.
const hasDemo = Astro.slots.has("demo");
const hero = {
  title: SOLUTION_LABELS[`/solutions/${view.id}/`] ?? view.fullName,
  display: false,
  eyebrow: view.fullName,
  sub: view.oneLiner,
  breadcrumb: view.breadcrumb,
  ctas: view.ctas,
  ctaPosition: "before-slot" as const,
};
---
<div class="template" data-template="solution">
  <PageHero {...hero} />
  {hasDemo && <PageSection id="demo" title="Explore an example" surface="carbon">
    <details class="solution-example"><summary>Open the illustrative example</summary>
      <div class="solution-demo" data-solution-demo><slot name="demo" /></div>
    </details>
  </PageSection>}

  <PageSection id="job" title="What the workflow does" width="prose">
    <div class="solution-flow">
      <p class="solution-lead">{view.job}</p>
      <h3 class="solution-subhead">What you receive</h3>
      <p class="solution-text">{view.artefact}</p>
    </div>
  </PageSection>

  <PageSection id="who" title="Where it can help">
    <div class="solution-flow solution-flow-loose">
      <ul class="need-profiles">
        {view.needProfiles.map((need) => (
          <li><LinkCard title={need.title} body={need.body} href={null} level={3} /></li>
        ))}
      </ul>
      {view.byIndustry.length > 0 && <ChipRow id="who-industries" label="By industry" chips={view.byIndustry} />}
    </div>
  </PageSection>

  <PageSection id="packages" title={view.packagesHeading}>
    <details class="solution-example"><summary>View deliverables and package scope</summary><div class="solution-packages">
      <PackageBlock pkg={view.generic} standardInclusions={view.standardInclusions} />
      {view.launch.length > 0 && (
        <Tabs id={`${view.id}-packages`} label={`${view.shortName} ${view.packagesHeading.toLowerCase()}`}>
          {view.launch.map((pkg) => (
            <TabPanel id={pkg.id} label={pkg.name}>
              <PackageBlock pkg={pkg} standardInclusions={view.standardInclusions} headingLevel={4} idSuffix="-block" />
            </TabPanel>
          ))}
        </Tabs>
      )}
      {view.onRequest.length > 0 && (
        <ul class="on-request">
          {view.onRequest.map((pkg) => (
            <li data-package-status="on-request">
              <BracketChip label="On request" /> <a href={pkg.href} class="solution-link">{pkg.name}</a>: {pkg.oneLiner}
            </li>
          ))}
        </ul>
      )}
    </div></details>
  </PageSection>

  {view.program && (
    <PageSection id="program" title="The program" width="prose">
      <div class="solution-flow">
        <h3 class="solution-subhead">{view.program.title}</h3>
        <p class="solution-text">{view.program.summary}</p>
        <p class="solution-text"><BracketChip label={view.program.duration} /></p>
        <ul class="solution-list">
          {view.program.bullets.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </PageSection>
  )}

  <PageSection id="testing" title="How we test it" width="prose">
    <div class="solution-flow">
      {/* Spec §4.4: acceptance tests on systems Techsider builds are labelled as not independent.
          ④ (the independence policy) is the independent evaluation, so it has no label. */}
      {view.independence === null && (
        <p class="solution-text" data-acceptance-label><BracketChip label={ACCEPTANCE_TEST_LABEL} /></p>
      )}
      <p class="solution-text">{view.howWeTest.summary}</p>
      <details class="solution-example"><summary>View testing checks</summary><ul class="solution-list">
        {view.howWeTest.bullets.map((item) => <li>{item}</li>)}
      </ul></details>
      {view.howWeTest.methodHref && (
        <p class="solution-text"><a href={view.howWeTest.methodHref} class="solution-link">Read the evaluation method</a></p>
      )}
    </div>
  </PageSection>

  <PageSection id="where-it-runs" title="Where it runs">
    <div class="solution-flow">
      <details class="solution-example"><summary>View deployment choices</summary><ol class="delivery-choices">
        {view.whereItRuns.choices.map((choice) => (
          <li class="delivery-choice" data-delivery-choice={choice.id}>
            <h3 class="solution-subhead"><span class="delivery-letter">({choice.letter})</span> {choice.title}</h3>
            <p class="solution-text">{choice.body}</p>
          </li>
        ))}
      </ol></details>
      <p class="solution-text">{view.whereItRuns.note}</p>
      <details class="solution-example"><summary>Read the data-location checklist</summary><h3 class="solution-subhead">The onshore note</h3>
      <ul class="solution-list">
        {view.whereItRuns.onshoreNote.map((item) => <li>{item}</li>)}
      </ul></details>
    </div>
  </PageSection>

  {view.independence && (
    <PageSection id="independence" title="Independence policy" width="prose">
      <ul class="solution-list">
        {view.independence.map((item) => <li>{item}</li>)}
      </ul>
    </PageSection>
  )}

  <PageSection id="limits" title="What we don't do" width="prose">
    <div class="solution-flow solution-flow-loose">
      {view.platformFirst && (
        <div class="platform-first" data-platform-first>
          <h3 class="solution-subhead platform-first-title">Use your platform's AI first</h3>
          <p class="solution-text">{view.platformFirst}</p>
        </div>
      )}
      <ul class="solution-list" data-dont-do>
        {view.dontDo.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </PageSection>

  <PageSection id="faq" title="Questions" width="prose">
    <FaqList items={view.faq} />
  </PageSection>

  <PageSection id="guides" title="Practical guides" width="prose">
    <ul class="solution-list">
      {(SOLUTION_GUIDES[view.id] ?? []).map((guide) => (
        <li><a href={guide.href} class="solution-link">{guide.title}</a></li>
      ))}
    </ul>
  </PageSection>

  <section id="contact" class="solution-closing">
    <div class="solution-closing-inner">
      <PromptBlock title="Start with one workflow." command={view.closing.command} args={view.closing.args} label={view.closing.label} href={view.closing.href} />
    </div>
  </section>
</div>

<style>
  .solution-example summary { cursor: pointer; min-height: 44px; font-size: 1.125rem; font-weight: 500; }
  .solution-example[open] summary { margin-bottom: 1.5rem; }
  /* Every section but the hero and the closing prompt is bone (PageSection's default), so the
     template's own text uses the bone pairs: carbon, muted-dark, bone-line and acid-deep.
     Each section body is one .solution-flow (or one list), so its rhythm doesn't depend on how
     PageSection spaces its children. */
  .solution-demo {
    min-width: 0;
  }
  .solution-flow {
    display: grid;
    gap: 1rem;
    min-width: 0;
  }
  .solution-flow-loose {
    gap: 2rem;
  }
  .solution-lead {
    margin: 0;
    font-size: 1.25rem;
    line-height: 1.5;
    overflow-wrap: anywhere;
  }
  .solution-text {
    margin: 0;
    line-height: 1.6;
    overflow-wrap: anywhere;
  }
  .solution-subhead {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 700;
    line-height: 1.3;
    overflow-wrap: anywhere;
  }
  .solution-flow > .solution-subhead:not(:first-child) {
    margin-top: 1rem;
  }
  .solution-list {
    margin: 0;
    padding-left: 1.25rem;
    list-style: square;
    line-height: 1.6;
    overflow-wrap: anywhere;
  }
  .solution-list li + li {
    margin-top: 0.375rem;
  }
  .solution-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--color-carbon);
    text-decoration: underline;
    text-decoration-color: var(--color-muted-dark);
    text-underline-offset: 3px;
    overflow-wrap: anywhere;
  }
  .solution-link:hover {
    text-decoration-color: currentColor;
    text-decoration-thickness: 2px;
  }
  .need-profiles {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .solution-packages {
    display: grid;
    gap: 3rem;
    min-width: 0;
  }
  .on-request {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
    line-height: 1.6;
    overflow-wrap: anywhere;
  }
  /* Choices (a) (b) (c) as a hairline cell grid: bone only (spec §6.4). */
  .delivery-choices {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-bone-line);
    border-left: 1px solid var(--color-bone-line);
  }
  .delivery-choice {
    display: grid;
    align-content: start;
    gap: 0.5rem;
    min-width: 0;
    padding: 1.25rem;
    border-right: 1px solid var(--color-bone-line);
    border-bottom: 1px solid var(--color-bone-line);
  }
  .delivery-letter {
    font-family: var(--font-mono);
    color: var(--color-acid-deep);
  }
  .platform-first {
    display: grid;
    gap: 0.5rem;
    padding-left: 1rem;
    border-left: 3px solid var(--color-acid-deep);
  }
  /* The closing prompt sits inside the content width on carbon, not in a band (spec §6.4). */
  .solution-closing {
    padding-block: 4rem;
  }
  .solution-closing-inner {
    max-width: 80rem;
    margin-inline: auto;
    padding-inline: 1rem;
  }
  @media (min-width: 40rem) {
    .solution-closing-inner {
      padding-inline: 1.5rem;
    }
  }
  @media (min-width: 64rem) {
    .solution-closing {
      padding-block: 6rem;
    }
  }
</style>
