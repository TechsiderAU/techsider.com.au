---
// Services page body (spec §8.6), rendered from the typed Services data (servicesData in
// src/content/page-schemas.ts). Phase C's /services/ route loads src/data/services.ts and wraps
// this in BaseLayout; in B2 only the preview gallery renders it. Every link comes from the
// SiteContext, so a page that isn't shown is never linked (Phase B2 scope ruling 4).
// - #method: ProcessSteps. Its phase sections #prove, #build and #run are the targets of the nav's
//   /services/#prove, #build and #run anchors (src/data/nav.ts).
// - #services-list: one card per service, with its entry label (spec §4.2 "Entry?"); a service
//   that is not an entry point shows no label. A service with a page of its own (SERVICE_PAGE)
//   links to it while that page is shown: the Evaluation Partner card is the /services/ hub's link
//   to its child page, which CI check 02 requires of a built hub.
// - #team names functions only: no names and no headcount (spec §8.6 block 5, D14/D15).
//   servicesData.team has no field that could carry either.
// - #where-it-runs is Home's block: the delivery choices lettered (a) (b) (c) by DELIVERY_LETTER,
//   then the onshore note. It never carries the onshore pillar (spec §3.2).
// Every section is bone except the hero and the closing prompt, so the template's own text uses
// the bone pairs: carbon, muted-dark, bone-line and acid-deep.
import PageHero from "../components/page/PageHero.astro";
import PageSection from "../components/page/PageSection.astro";
import LinkCard from "../components/page/LinkCard.astro";
import ProcessSteps from "../components/page/ProcessSteps.astro";
import DataTable from "../components/ui/DataTable.astro";
import FaqList from "../components/ui/FaqList.astro";
import PromptBlock from "../components/ui/PromptBlock.astro";
import type { ServicesData } from "../content/page-schemas";
import { DELIVERY_LETTER, SERVICES_H1 } from "../lib/fixed-copy";
import type { PageKey, SiteContext } from "../lib/site";

interface Props {
  services: ServicesData;
  site: SiteContext;
}

const { services, site } = Astro.props;

type Entry = ServicesData["services"][number]["entry"];
// The entry label on each service card (spec §4.2 "Entry?" column).
const ENTRY_LABEL: Record<Entry, string | null> = {
  entry: "Entry point",
  "after-audit-or-trial": "After an Audit or Trial",
  secondary: "Secondary",
  "not-entry": null,
};

// The services that have a page of their own, by service id. Every other card is plain text.
const SERVICE_PAGE: Partial<Record<string, PageKey>> = { "evaluation-partner": "evaluationPartner" };
const serviceHref = (id: string): string | null => {
  const key = SERVICE_PAGE[id];
  return key === undefined ? null : site.page(key).href;
};

// Spec §10.1: the Fit Call CTA preselects "Not sure yet"; the method link shows only once its page does.
const fitCall = { label: "Talk to us about a Fit Call", href: site.contact({ interest: "not-sure" }) };
const methodHref = site.page("evaluationMethod").href;
const ctas = {
  primary: fitCall,
  secondary: methodHref === null ? null : { label: "Read the evaluation method", href: methodHref },
};
const entryColumns = [
  { key: "buyer", label: "Buyer" },
  { key: "entry", label: "Start with" },
  { key: "then", label: "Then" },
];
const entryRows = services.entryOffers.map((o) => ({ buyer: o.buyer, entry: o.entry, then: o.then }));
const choices = services.deliveryChoices
  .map((c) => ({ ...c, letter: DELIVERY_LETTER[c.id] }))
  .sort((x, y) => x.letter.localeCompare(y.letter));
---
<div class="template" data-template="services">
  <PageHero title={SERVICES_H1} display={false} art="workflow" eyebrow="Design · Build · Support" sub="We turn manual processes into AI workflows, connect your systems and support your team from the first test to everyday use." ctas={ctas} />

  <PageSection id="method" title="Prove → Build → Run">
    <ProcessSteps phases={services.phases} />
  </PageSection>

  <PageSection id="services-list" title="Services">
    <ul class="services-cards">
      {services.services.map((s) => (
        <li class="services-card" data-service={s.id} data-entry={s.entry}>
          <LinkCard title={s.name} href={serviceHref(s.id)} eyebrow={ENTRY_LABEL[s.entry] ?? undefined} body={s.what} meta={`For: ${s.forWhom}`} />
        </li>
      ))}
    </ul>
  </PageSection>

  <PageSection id="entry" title="Where to start">
    <details class="services-details"><summary>View starting options</summary>
    <div class="services-detail-body">
    <DataTable caption="Entry offer by buyer" columns={entryColumns} rows={entryRows} rowHeader="buyer" />
  </div>
    </details>
  </PageSection>

  <PageSection id="team" title="Who you work with" width="prose">
    <details class="services-details"><summary>View team roles</summary>
    <div class="services-detail-body">
    <p class="services-lead" data-team-summary>{services.team.summary}</p>
    <ul class="services-functions" data-team-functions>
      {services.team.functions.map((f) => (
        <li>
          <h3 class="services-subhead">{f.title}</h3>
          <p class="services-text">{f.body}</p>
        </li>
      ))}
    </ul>
  </div>
    </details>
  </PageSection>

  <PageSection id="where-it-runs" title="Where it runs">
    <details class="services-details"><summary>View deployment and data locations</summary>
    <div class="services-detail-body">
    <ol class="delivery-choices">
      {choices.map((c) => (
        <li class="delivery-choice" data-delivery-choice={c.id}>
          <h3 class="services-subhead"><span class="delivery-letter">({c.letter})</span> {c.title}</h3>
          <p class="services-text">{c.body}</p>
        </li>
      ))}
    </ol>
    <div class="services-note">
      <h3 class="services-subhead">The onshore note</h3>
      <ul class="services-list" data-onshore-note>
        {services.onshoreNote.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </div>
    </details>
  </PageSection>

  <PageSection id="independence" title="Independence policy" width="prose">
    <details class="services-details"><summary>View our independence policy</summary>
    <div class="services-detail-body">
    <ul class="services-list">
      {services.independence.map((item) => <li>{item}</li>)}
    </ul>
  </div>
    </details>
  </PageSection>

  <PageSection id="de-risk" title="How we de-risk">
    <details class="services-details"><summary>View delivery safeguards</summary>
    <div class="services-detail-body">
    <ul class="services-cards">
      {services.deRisk.map((d) => (
        <li class="services-card">
          <LinkCard title={d.title} href={null} body={d.body} />
        </li>
      ))}
    </ul>
  </div>
    </details>
  </PageSection>

  <PageSection id="faq" title="Questions" width="prose">
    <FaqList items={services.faq} />
  </PageSection>

  <div id="contact" class="services-closing">
    <PromptBlock title="Bring us one manual process." command="talk_to_us" args="--about=fit-call" label={fitCall.label} href={fitCall.href} />
  </div>
</div>

<style>
  .services-details summary { cursor: pointer; min-height: 44px; font-size: 1rem; font-weight: 500; }
  .services-detail-body { display: grid; gap: 2rem; margin-top: 1rem; }
  .services-cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .services-card {
    display: flex;
    min-width: 0;
  }
  .services-card > :global(*) {
    flex: 1;
  }
  .services-lead {
    margin: 0;
    font-size: 1.25rem;
    line-height: 1.5;
    overflow-wrap: anywhere;
  }
  .services-functions {
    display: grid;
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .services-subhead {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 700;
    line-height: 1.3;
    overflow-wrap: anywhere;
  }
  .services-text {
    margin: 0.5rem 0 0;
    line-height: 1.6;
    overflow-wrap: anywhere;
  }
  .services-list {
    margin: 0;
    padding-left: 1.25rem;
    list-style: square;
    line-height: 1.6;
    overflow-wrap: anywhere;
  }
  .services-list li + li {
    margin-top: 0.375rem;
  }
  .services-note .services-list {
    margin-top: 1rem;
  }
  /* (a) (b) (c): lettered in HTML, so the list's own markers are off. */
  .delivery-choices {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .delivery-choice {
    min-width: 0;
    padding-top: 1rem;
    border-top: 2px solid var(--color-carbon);
  }
  .delivery-letter {
    font-family: var(--font-mono);
    color: var(--color-acid-deep);
  }
  /* The closing prompt sits inside the content width on carbon, not in a band (spec §6.4). */
  .services-closing {
    max-width: 80rem;
    margin-inline: auto;
    padding: 4rem 1rem;
  }
  @media (min-width: 40rem) {
    .services-closing {
      padding-inline: 1.5rem;
    }
  }
  @media (min-width: 64rem) {
    .services-closing {
      padding-block: 6rem;
    }
  }
</style>
