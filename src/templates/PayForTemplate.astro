---
// What you already pay for (spec §8.7): the client-side checker's page. Body only: its route,
// src/pages/resources/what-you-already-pay-for/[...page].astro, passes siteContext(isPreview()) and
// the vendor facts' as-at date, fills the slots and renders this inside BaseLayout. The hero carries
// the checker badge, always.
// Named slots:
// - `checker`: PlatformChecker (src/components/demo/), over src/data/platform-ai.json as the route
//   reads it at build time; it makes no network calls;
// - `fallback`: PlatformFacts, the full table, which reads without JavaScript.
// The page is the checker's canonical URL; the ⑤ demo page embeds the same checker (spec §8.8).
import PageHero from "../components/page/PageHero.astro";
import PageSection from "../components/page/PageSection.astro";
import PromptBlock from "../components/ui/PromptBlock.astro";
import { CHECKER_BADGE } from "../lib/fixed-copy";
import { crumbs, type SiteContext } from "../lib/site";

interface Props {
  site: SiteContext;
  asAt: Date | null;
}

const { site, asAt } = Astro.props;
const page = site.page("payFor");
const switchOn = site.solutions[4];

// Content dates are UTC midnights ("2026-09-01"), so they print in UTC: "1 September 2026".
const formatDate = (d: Date) => d.toLocaleDateString("en-AU", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" });
const isoDate = (d: Date) => d.toISOString().slice(0, 10);
---
<div class="template" data-template="pay-for">
  <PageHero
    title={`${page.label}.`}
    eyebrow="resources"
    sub={page.oneLiner}
    breadcrumb={crumbs(site, ["resources", "payFor"])}
  >
    <p class="payfor-badge" data-hero-badge>{CHECKER_BADGE}</p>
    {asAt && (
      <p class="payfor-as-at" data-vendor-as-at>Vendor facts as at <time datetime={isoDate(asAt)}>{formatDate(asAt)}</time></p>
    )}
  </PageHero>

  <PageSection id="checker" title="The checker">
    <slot name="checker" />
  </PageSection>

  <PageSection id="how-it-works" title="How it works">
    <slot name="fallback" />
  </PageSection>

  <section id="contact" class="payfor-closing">
    <PromptBlock
      command="talk_to_us"
      args={`--about=${switchOn.id}`}
      label={`Talk to us about ${switchOn.shortName}`}
      href={site.contact({ interest: switchOn.id })}
    />
  </section>
</div>

<style>
  /* The badge is text in an outlined tag, never a colour alone (spec §6.6). */
  .payfor-badge {
    display: inline-block;
    max-width: 100%;
    margin: 0;
    padding: 0.25rem 0.625rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    line-height: 1.4;
    border: 1px solid var(--color-acid);
    border-radius: 4px;
    overflow-wrap: anywhere;
  }
  .payfor-as-at {
    margin: 0.75rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--color-muted);
  }
  /* The closing prompt sits inside the content width on carbon, a normal section's space above
     the footer: never a full-width band (spec §6.4). */
  .payfor-closing {
    padding: 4rem 1rem;
  }
  @media (min-width: 64rem) {
    .payfor-closing {
      padding-block: 6rem;
    }
  }
  /* "Talk to us about {solution}" is longer than .btn's one line allows at 320px (global.css
     sets white-space: nowrap): let it wrap. */
  [data-template="pay-for"] :global(.btn) {
    padding-block: 0.5rem;
    white-space: normal;
    text-align: center;
  }
</style>
