---
// The Industries hub (spec §8.4), body only: a Phase C route loads the nine industries and five
// solutions, calls industriesHubView() and wraps this in BaseLayout. A hero; nine deep cards
// (constraint hook, three flagship use cases with their solution numbers, each on-request one
// labelled "On request", three obligation chips linking to their regulatory-map rows); the
// solution × industry matrix; the closing prompt.
// Every link comes from the view: a null href renders as plain text, never as a dead link.
import { AUTOMATION } from "../lib/marketing";
import PageHero from "../components/page/PageHero.astro";
import PageSection from "../components/page/PageSection.astro";
import ChipRow from "../components/page/ChipRow.astro";
import DataTable from "../components/ui/DataTable.astro";
import PromptBlock from "../components/ui/PromptBlock.astro";
import type { IndustriesHubView } from "../lib/views/hubs";

interface Props {
  view: IndustriesHubView;
}

const { view } = Astro.props;
---
<div class="template" data-template="industries-hub">
  <PageHero title="Your industry. Your workflows." display={false} art="workflow" eyebrow="Industries" sub="Practical AI automation shaped by the tools you use and the requirements your team works under." />

  <PageSection id="industries" title="Find your industry">
    <ul class="industry-cards">
      {view.cards.map((card) => (
        <li class="industry-cell">
          <article class="industry-card" data-industry-card={card.id} aria-labelledby={`industry-${card.id}-heading`}>
            <h3 id={`industry-${card.id}-heading`} class="industry-card-title">
              {card.href ? <a href={card.href} class="industry-card-link">{card.shortName}</a> : card.shortName}
            </h3>
            <p class="industry-card-hook">{AUTOMATION.industries[card.shortName] ?? card.hook}</p>
            <details class="industry-details"><summary>Use cases and requirements</summary>
            <ul class="industry-card-uses">
              {card.useCases.map((useCase) => (
                <li><span class="industry-card-number">{useCase.number}</span> <span>{useCase.name}{useCase.onRequest && " "}{useCase.onRequest && <span class="industry-card-on-request">On request</span>}</span></li>
              ))}
            </ul>
            <ChipRow id={`industry-${card.id}-chips`} label="Designed around" chips={card.chips} />
            </details>
          </article>
        </li>
      ))}
    </ul>
  </PageSection>

  <PageSection id="matrix" title="Solutions by industry">
    <DataTable
      caption={view.matrix.caption}
      columns={view.matrix.columns}
      rows={view.matrix.rows}
      rowHeader={view.matrix.rowHeader}
      rowIds={view.matrix.rowIds}
      rowMarker="data-matrix-row"
    />
  </PageSection>

  <div id="contact" class="template-closing">
    <PromptBlock title="Find a useful first step." command={view.closing.command} args={view.closing.args} label={view.closing.label} href={view.closing.href} />
  </div>
</div>

<style>
  .industry-details summary { min-height: 44px; display: list-item; cursor: pointer; font-size: .875rem; font-weight: 500; }
  .industry-details[open] summary { margin-bottom: 1rem; }
  .industry-details :global(.chip-row) { margin-top: 1rem; }
  /* The cards share hairlines: the one hairline cell grid on this page, on bone only (spec §6.4). */
  .industry-cards {
    display: grid;
    gap: 1px;
    margin: 0;
    padding: 0;
    list-style: none;
    background: var(--color-bone-line);
    border: 1px solid var(--color-bone-line);
  }
  @media (min-width: 40rem) {
    .industry-cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 64rem) {
    .industry-cards {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .industry-cell {
    display: flex;
    min-width: 0;
    background: var(--color-bone);
  }
  .industry-card {
    display: grid;
    flex: 1;
    align-content: start;
    gap: 1rem;
    min-width: 0;
    padding: 1.5rem 1.25rem;
  }
  .industry-card-title {
    margin: 0;
    font-size: clamp(1.25rem, 1.1rem + 0.6vw, 1.5rem);
    font-weight: 600;
    line-height: 1.2;
    overflow-wrap: anywhere;
  }
  .industry-card-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: inherit;
    text-decoration: underline;
    text-decoration-color: var(--color-muted-dark);
    text-underline-offset: 4px;
  }
  .industry-card-link:hover {
    text-decoration-color: currentColor;
    text-decoration-thickness: 2px;
  }
  .industry-card-hook {
    margin: 0;
    line-height: 1.5;
    overflow-wrap: anywhere;
  }
  .industry-card-uses {
    display: grid;
    gap: 0.375rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.9375rem;
    line-height: 1.45;
  }
  .industry-card-uses li {
    display: flex;
    gap: 0.5rem;
    min-width: 0;
    overflow-wrap: anywhere;
  }
  /* The solution number: lime-family text on bone is acid-deep (spec §6.1). */
  .industry-card-number {
    flex: none;
    font-family: var(--font-mono);
    font-weight: 600;
    color: var(--color-acid-deep);
  }
  /* "On request" is text in an outlined tag, never a colour alone (spec §5, §6.6), as on the industry page. */
  .industry-card-on-request {
    display: inline-block;
    padding: 0.125rem 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1.2;
    white-space: nowrap;
    border: 1px solid currentColor;
    border-radius: 4px;
  }
  .template-closing {
    max-width: 80rem;
    margin-inline: auto;
    padding: 4rem 1rem;
  }
  @media (min-width: 40rem) {
    .template-closing {
      padding-inline: 1.5rem;
    }
  }
  @media (min-width: 64rem) {
    .template-closing {
      padding-block: 6rem;
    }
  }
</style>
