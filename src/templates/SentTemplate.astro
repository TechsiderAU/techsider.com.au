---
// The enquiry confirmation (spec §8.11), body only: the form provider redirects here after a
// plain POST. The gated route at /contact/sent/ wraps this in BaseLayout (noindex, and left out of
// the sitemap). It repeats the contact page's reply-time sentence, read from the same
// contact.replyTime, then what happens next and the email address as plain text.
import PageHero from "../components/page/PageHero.astro";
import PageSection from "../components/page/PageSection.astro";
import type { ContactData } from "../content/page-schemas";
import type { SiteContext } from "../lib/site";

interface Props {
  contact: ContactData;
  site: SiteContext;
}

const { contact, site } = Astro.props;
---
<div class="template" data-template="sent">
  <PageHero title="Message sent." highlight="sent" />

  <PageSection id="next" title="What happens next" width="prose">
    <p class="sent-reply">We’ll review your enquiry and discuss whether we can help with the workflow.</p>
    <ol class="sent-steps">
      {contact.whatNext.map((step) => <li>{step}</li>)}
    </ol>
  </PageSection>

  <PageSection id="email" title="Email us" width="prose">
    <p class="sent-email"><code class="sent-address" data-email>{site.email}</code></p>
  </PageSection>
</div>

<style>
  .sent-reply,
  .sent-email {
    margin: 0;
  }
  .sent-reply {
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.5;
  }
  .sent-steps {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding-left: 1.5rem;
    list-style: decimal;
    line-height: 1.5;
  }
  .sent-address {
    font-family: var(--font-mono);
    font-size: 1.125rem;
    overflow-wrap: anywhere;
  }
</style>
