---
// A legal document (spec §8.11: the privacy policy, the website terms), body only: a Phase C
// route loads the documents entry, renders its markdown into the default slot and wraps this in
// BaseLayout. The hero holds the breadcrumb, the H1 (the document's title), its summary and its
// dates; the body is typeset by Prose on bone.
import PageHero from "../components/page/PageHero.astro";
import Prose from "../components/page/Prose.astro";
import type { DocumentData } from "../content/page-schemas";
import type { Link } from "../lib/site";

interface Props {
  doc: DocumentData;
  breadcrumb: Link[];
}

const { doc, breadcrumb } = Astro.props;
const formatDate = (d: Date) => d.toLocaleDateString("en-AU", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" });
const isoDate = (d: Date) => d.toISOString().slice(0, 10);
---
<div class="template" data-template="document">
  <PageHero title={doc.title} display={false} sub={doc.summary} breadcrumb={breadcrumb}>
    <p class="doc-dates" data-document-dates>
      <span>Last updated <time datetime={isoDate(doc.lastUpdated)}>{formatDate(doc.lastUpdated)}</time></span>
      {doc.effective && <span>Effective <time datetime={isoDate(doc.effective)}>{formatDate(doc.effective)}</time></span>}
    </p>
  </PageHero>

  <div class="doc-body surface-bone" data-document-body>
    <div class="doc-inner">
      <Prose><slot /></Prose>
    </div>
  </div>
</div>

<style>
  .doc-dates {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--color-muted);
  }
  .doc-body {
    padding-block: 4rem;
  }
  @media (min-width: 64rem) {
    .doc-body {
      padding-block: 6rem;
    }
  }
  .doc-inner {
    max-width: 80rem;
    margin-inline: auto;
    padding-inline: 1rem;
  }
  @media (min-width: 40rem) {
    .doc-inner {
      padding-inline: 1.5rem;
    }
  }
</style>
