---
// The Insights index (spec §8.9), restyled in Phase B2: a carbon PageHero (the bracket eyebrow
// "resources", the display H1 "Insights." and the nav one-liner), then every published post,
// newest first, as an InsightCard (type tag, date, reading time, industry chips) in a bone
// "All posts" section. Industry chips link only to industry pages this build shows.
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/page/PageHero.astro";
import PageSection from "../../components/page/PageSection.astro";
import InsightCard from "../../components/page/InsightCard.astro";
import { PAGES, isPreview } from "../../data/nav";
import { pageTitle } from "../../lib/meta";
import { siteContext } from "../../lib/site";
import { insightCards } from "../../lib/views/insights";

const site = siteContext(isPreview());
const insights = site.page("insights");
const entry = PAGES.find((p) => p.path === insights.path);
if (entry === undefined) throw new Error(`nav.ts has no page at ${insights.path}`);
const cards = insightCards(await getCollection("insights"), site);
---
<BaseLayout
  title={pageTitle(entry)}
  description="Field notes on production LLM systems, RAG, agents, and AI data sovereignty for Australian regulated industries."
>
  <PageHero title="Insights." eyebrow="resources" sub={insights.oneLiner} />
  <PageSection id="posts" title="All posts">
    <ul class="post-list" data-post-list>
      {cards.map((card) => (
        <li><InsightCard card={card} /></li>
      ))}
    </ul>
  </PageSection>
</BaseLayout>

<style>
  .post-list {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 48rem) {
    .post-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 64rem) {
    .post-list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .post-list > li {
    display: flex;
    min-width: 0;
  }
  .post-list > li > :global(*) {
    flex: 1;
  }
</style>
