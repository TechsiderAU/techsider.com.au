---
// /resources/ (spec §7.1, §8.7): the Resources hub. Live from Phase C, it lists only the resources
// this build shows (Insights until Phase D adds the rest), each as a link.
import type { GetStaticPaths } from "astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ResourcesHubTemplate from "../../templates/ResourcesHubTemplate.astro";
import { isPreview } from "../../data/nav";
import { pageDescription, pageTitle } from "../../lib/meta";
import { pageAt, singletonPaths } from "../../lib/pages";
import { siteContext } from "../../lib/site";

export const getStaticPaths = (() => singletonPaths("/resources/")) satisfies GetStaticPaths;

const entry = pageAt("/resources/");
---
<BaseLayout title={pageTitle(entry)} description={pageDescription(entry)}>
  <ResourcesHubTemplate site={siteContext(isPreview())} />
</BaseLayout>
