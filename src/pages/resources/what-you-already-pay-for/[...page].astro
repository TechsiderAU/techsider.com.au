---
// /resources/what-you-already-pay-for/ (spec §7.1, §8.7): the "What you already pay for" checker's
// canonical page, live from Phase D Task 6. The vendor facts are src/data/platform-ai.json, read and
// validated here at build time and built into the page; nothing on it makes a network call.
// PlatformChecker fills the #checker section and PlatformFacts, the full no-JS table, #how-it-works.
// The ⑤ demo page renders the same pair and points its canonical link here (spec §8.8).
import type { GetStaticPaths } from "astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PayForTemplate from "../../../templates/PayForTemplate.astro";
import PlatformChecker from "../../../components/demo/PlatformChecker.astro";
import PlatformFacts from "../../../components/demo/PlatformFacts.astro";
import { platformAiFile } from "../../../content/schemas";
import platformAi from "../../../data/platform-ai.json";
import { isPreview } from "../../../data/nav";
import { pageDescription, pageTitle } from "../../../lib/meta";
import { pageAt, singletonPaths } from "../../../lib/pages";
import { siteContext } from "../../../lib/site";
import { checkerView } from "../../../lib/views/checker";

export const getStaticPaths = (() => singletonPaths("/resources/what-you-already-pay-for/")) satisfies GetStaticPaths;

const entry = pageAt("/resources/what-you-already-pay-for/");
const site = siteContext(isPreview());
// ⚑ owner: before launch, re-check every entry of src/data/platform-ai.json on its vendor page, and the
// entries held out as unverified (Task 1): platform-ai.md was one research pass, with no adversarial fact-check.
const file = platformAiFile.parse(platformAi);
const view = checkerView(file, site);
---
<BaseLayout title={pageTitle(entry)} description={pageDescription(entry)}>
  <PayForTemplate site={site} asAt={file.asAt}>
    <PlatformChecker slot="checker" view={view} headingLevel={3} />
    <PlatformFacts slot="fallback" view={view} />
  </PayForTemplate>
</BaseLayout>
