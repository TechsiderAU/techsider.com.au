---
// One solution page (spec §8.3): /solutions/<id>/ for every solution this build shows. The route
// stays thin, as the gallery specimens are: it builds the SolutionView from the solution's YAML
// entry, the shared offer copy in src/data/services.ts and this build's SiteContext, and hands it
// to SolutionTemplate inside BaseLayout. The hero's demo slot stays empty until Phase D adds the
// demos (the ④ sample report included).
import type { GetStaticPaths, InferGetStaticParamsType, InferGetStaticPropsType } from "astro";
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SolutionTemplate from "../../templates/SolutionTemplate.astro";
import { isPreview } from "../../data/nav";
import { SERVICES } from "../../data/services";
import { pageDescription, pageTitle } from "../../lib/meta";
import { pageAt, shownIds } from "../../lib/pages";
import { siteContext } from "../../lib/site";
import { solutionView } from "../../lib/views/solution";

// Every shown solution page needs its content entry. A missing one fails the build here, as
// check 01 fails a live nav entry without its YAML file.
export const getStaticPaths = (async () => {
  const entries = new Map((await getCollection("solutions")).map((entry) => [entry.id, entry]));
  return shownIds("/solutions/").map((id) => {
    const entry = entries.get(id);
    if (entry === undefined) throw new Error(`/solutions/${id}/ is shown, but src/content/solutions/${id}.yaml does not exist`);
    return { params: { id }, props: { data: entry.data } };
  });
}) satisfies GetStaticPaths;

type Params = InferGetStaticParamsType<typeof getStaticPaths>;
type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { id } = Astro.params as Params;
const { data }: Props = Astro.props;
const entry = pageAt(`/solutions/${id}/`);
const view = solutionView({ id, data, shared: SERVICES, site: siteContext(isPreview()) });
---
<BaseLayout title={pageTitle(entry)} description={pageDescription(entry)}>
  <SolutionTemplate view={view} />
</BaseLayout>
