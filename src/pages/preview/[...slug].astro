---
// Template-preview gallery: the shared components and templates rendered from fictional
// fixtures (src/fixtures/). getStaticPaths returns no paths unless TECHSIDER_NAV_PREVIEW=1,
// so the production dist/ has no /preview/ pages and no fixture data; only
// `npm run build:preview` (dist-preview/, the e2e target) builds them.
import type { GetStaticPaths } from "astro";
import PreviewLayout from "../../layouts/PreviewLayout.astro";
import Tabs from "../../components/ui/Tabs.astro";
import TabPanel from "../../components/ui/TabPanel.astro";
import GalleryStaticA from "../../components/preview/GalleryStaticA.astro";
import GalleryStaticB from "../../components/preview/GalleryStaticB.astro";
import { isPreview } from "../../data/nav";
import type { PreviewPage } from "../../fixtures/preview-pages";

// Fixtures are reached only through `await import()`, never a static import (type-only
// imports are fine): a module both statically and dynamically imported makes Vite log
// [WARN] INEFFECTIVE_DYNAMIC_IMPORT, which fails the pristine-build gate.
export const getStaticPaths = (async () => {
  if (!isPreview()) return [];
  const { PREVIEW_PAGES, previewPath } = await import("../../fixtures/index.ts");
  const links = PREVIEW_PAGES.map((p) => ({ slug: p.slug, title: p.title, href: previewPath(p) }));
  return PREVIEW_PAGES.map((page) => ({
    params: { slug: page.slug === "" ? undefined : page.slug },
    props: { page, links },
  }));
}) satisfies GetStaticPaths;

interface Props {
  page: PreviewPage;
  links: { slug: string; title: string; href: string }[];
}

const { page, links } = Astro.props;

// Fixture data for the specimens: a dynamic import, as in getStaticPaths (never a static one).
const fx = await import("../../fixtures/index.ts");

// /preview/tabs/: two independent Tabs groups, built from the fixtures the way the B2 templates
// will use them.
// - On carbon: an industry's four workflow stages.
// - On bone: a solution's packages, as spec §8.3 block 4 lays them out. The generic package
//   renders first, as a full block and not a tab; then only the launch packages become tabs;
//   on-request packages follow as one-line "On request" entries; internal packages never render
//   (spec §4.1). Every tab and full block carries data-package-tab and data-package-status="launch",
//   and every other rendered package its data-package-status (CI check 10's DOM contract).
const { industryFixture, solutionFixture, SOLUTION_FIXTURE_ID } = fx;
const workflowPanels = industryFixture.workflow.map((stage, i, all) => ({
  id: stage.id,
  label: stage.stage,
  items: stage.useCases.map((u) => (u.status === "on-request" ? `${u.name} (On request)` : u.name)),
  next: all[i + 1] ? { id: all[i + 1].id, label: all[i + 1].stage } : undefined,
}));
const genericPackage = solutionFixture.genericPackage;
const launchPackages = solutionFixture.packages.flatMap((p) => (p.status === "launch" ? [p] : []));
const onRequestPackages = solutionFixture.packages.flatMap((p) => (p.status === "on-request" ? [p] : []));
const packageItems = (p: typeof genericPackage) => [p.scope, ...p.inclusions, p.timeline];
const interestHref = `/contact/?interest=${SOLUTION_FIXTURE_ID}`;

// /preview/components/ shows every component twice: on carbon, and inside .surface-bone.
// Specimens rendered inside the loop suffix their ids with `-${surface.id}` to keep ids unique.
const surfaces = [
  { id: "carbon", label: "On carbon", bone: false },
  { id: "bone", label: "On bone", bone: true },
];
---
<PreviewLayout title={page.title}>
  <div class="preview-wrap preview-intro">
    <h1 class="type-display preview-title">{page.title}</h1>
    {page.kind === "index" && (
      <p class="preview-lede">Shared components rendered from fictional fixture data, for review before real content exists. Not part of the published site.</p>
    )}
    <nav aria-label="Template preview pages">
      <ul class="preview-pages">
        {links.map((l) => (
          <li>
            <a href={l.href} class="preview-link" aria-current={l.slug === page.slug ? "page" : undefined}>{l.title}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>

  {page.kind === "components" && surfaces.map((surface) => (
    <section
      id={`surface-${surface.id}`}
      class:list={["preview-surface", surface.bone && "surface-bone"]}
      aria-labelledby={`surface-${surface.id}-heading`}
      data-preview-surface={surface.id}
    >
      <div class="preview-wrap">
        <h2 id={`surface-${surface.id}-heading`} class="preview-surface-heading">{surface.label}</h2>
        <GalleryStaticA surface={surface.id} faq={surface.bone ? fx.solutionFixture.faq : fx.industryFixture.faq} />
        {/* Components A render above, once in each surface section. Components B render after
            both sections: GalleryStaticB draws its own carbon and bone sections. */}
      </div>
    </section>
  ))}

  {page.kind === "components" && (
    <GalleryStaticB
      panel={fx.mockPanelFixture}
      report={fx.sampleReportFixture}
      trace={fx.traceFixture}
      rows={fx.regulatoryFixture.rows}
    />
  )}

  {page.kind === "tabs" && (
    <section id="tab-groups" class="preview-surface" aria-labelledby="tab-groups-heading" data-preview-surface="tabs">
      <div class="preview-wrap">
        <h2 id="tab-groups-heading" class="preview-surface-heading">Tab groups</h2>
        <div class="tabs-specimen">
          <p class="tabs-specimen-label">Fixture workflow stages</p>
          <Tabs id="fixture-workflow" label="Fixture workflow stages">
            {workflowPanels.map((panel) => (
              <TabPanel id={panel.id} label={panel.label}>
                <ul class="tabs-specimen-list">
                  {panel.items.map((item) => <li>{item}</li>)}
                </ul>
                {panel.next && (
                  <a href={`#${panel.next.id}`} class="tabs-specimen-next">Next stage: {panel.next.label}</a>
                )}
              </TabPanel>
            ))}
          </Tabs>
        </div>
        <div class="tabs-specimen surface-bone" data-package-specimen>
          <p class="tabs-specimen-label">Fixture packages</p>
          <section
            class="package-block"
            aria-labelledby={`${genericPackage.id}-heading`}
            data-package-tab
            data-package-status={genericPackage.status}
          >
            <h3 id={`${genericPackage.id}-heading`} class="package-block-heading">{genericPackage.name}</h3>
            <ul class="tabs-specimen-list">
              {packageItems(genericPackage).map((item) => <li>{item}</li>)}
            </ul>
          </section>
          <Tabs id="fixture-packages" label="Fixture launch packages">
            {launchPackages.map((p) => (
              <TabPanel id={p.id} label={p.name}>
                <div data-package-tab data-package-status={p.status}>
                  <ul class="tabs-specimen-list">
                    {packageItems(p).map((item) => <li>{item}</li>)}
                  </ul>
                </div>
              </TabPanel>
            ))}
          </Tabs>
          <ul class="package-on-request">
            {onRequestPackages.map((p) => (
              <li data-package-status={p.status}>
                <span class="package-on-request-label">On request</span>{" "}
                <a href={interestHref} class="package-on-request-link">{p.name}</a>: {p.oneLiner}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>
  )}
</PreviewLayout>

<style>
  .preview-wrap {
    max-width: 80rem; /* the shell's max-w-7xl */
    margin-inline: auto;
    padding-inline: 1rem;
  }
  @media (min-width: 40rem) {
    .preview-wrap {
      padding-inline: 1.5rem;
    }
  }
  .preview-intro {
    padding-block: 3rem 2rem;
  }
  .preview-title {
    font-size: clamp(1.75rem, 5vw, 2.5rem);
  }
  .preview-lede {
    max-width: 60ch;
    margin-top: 1rem;
    color: var(--color-muted);
  }
  .preview-pages {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    margin-top: 1.5rem;
  }
  .preview-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--color-bone);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .preview-link:hover {
    color: var(--color-acid);
  }
  .preview-link[aria-current="page"] {
    font-weight: 700;
    text-decoration-color: var(--color-acid);
    text-decoration-thickness: 2px;
  }
  .preview-surface {
    padding-block: 3rem;
    border-top: 1px solid var(--color-graphite);
  }
  .preview-surface-heading {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    text-transform: lowercase;
  }
  .tabs-specimen {
    margin-top: 2rem;
  }
  .tabs-specimen.surface-bone {
    padding: 2rem 1rem;
  }
  @media (min-width: 40rem) {
    .tabs-specimen.surface-bone {
      padding-inline: 1.5rem;
    }
  }
  .tabs-specimen-label {
    margin-bottom: 1rem;
    font-weight: 700;
  }
  .tabs-specimen-list {
    list-style: square;
    padding-left: 1.25rem;
  }
  .tabs-specimen-next,
  .package-on-request-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .tabs-specimen-next {
    margin-top: 0.5rem;
  }
  .package-block {
    margin-bottom: 2rem;
  }
  .package-block-heading {
    margin-bottom: 0.75rem;
    font-size: 1.125rem;
    font-weight: 700;
  }
  .package-on-request {
    margin-top: 1.5rem;
  }
  .package-on-request-label {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-muted-dark);
  }
</style>
