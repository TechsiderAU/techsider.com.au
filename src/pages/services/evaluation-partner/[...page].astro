---
// /services/evaluation-partner/ (spec §8.6 "Evaluation Partner"): EvaluationPartnerTemplate over
// the Services data (its evaluationPartner block and the shared independence policy), fed exactly
// as the gallery's EvaluationPartnerSpecimen feeds it from servicesFixture. The workstream is a
// Service in the page's JSON-LD (spec §11.3), named as the breadcrumb names it and described by the h1.
import type { GetStaticPaths } from "astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import EvaluationPartnerTemplate from "../../../templates/EvaluationPartnerTemplate.astro";
import { isPreview } from "../../../data/nav";
import { SERVICES } from "../../../data/services";
import { service } from "../../../lib/json-ld";
import { pageAt, singletonPaths } from "../../../lib/pages";
import { pageDescription, pageTitle } from "../../../lib/meta";
import { siteContext } from "../../../lib/site";

export const getStaticPaths = (() => singletonPaths("/services/evaluation-partner/")) satisfies GetStaticPaths;

const page = pageAt("/services/evaluation-partner/");
const graph = [service(Astro.site ?? Astro.url, { path: page.path, key: "service", name: page.fullName, description: SERVICES.evaluationPartner.promise })];
---
<BaseLayout title={pageTitle(page)} description={pageDescription(page)} graph={graph}>
  <EvaluationPartnerTemplate services={SERVICES} site={siteContext(isPreview())} />
</BaseLayout>
