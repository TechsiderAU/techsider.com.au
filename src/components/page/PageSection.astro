---
// One page section: a <section> named by its heading, on bone (the default reading surface) or
// carbon, with the 80rem container (or a 48rem reading measure for `width="prose"`), a
// SectionHeader whose heading id is "{id}-heading", then the slot in a column with a 2rem gap.
// Vertical rhythm: 4rem, 6rem from 64rem. A carbon section also carries bg-carbon, so it stays a
// dark island if it is ever nested inside bone. A PageSection nested in another PageSection drops
// its own gutters and most of its top padding: it is a sub-block (level 3) of its parent.
import SectionHeader from "../ui/SectionHeader.astro";

interface Props {
  id: string;
  title: string;
  surface?: "carbon" | "bone";
  prompt?: string;
  lede?: string;
  width?: "wide" | "prose";
  level?: 2 | 3;
}

const { id, title, surface = "bone", prompt, lede, width = "wide", level = 2 } = Astro.props;
const headingId = `${id}-heading`;
---
<section
  id={id}
  aria-labelledby={headingId}
  class:list={["page-section", surface === "bone" ? "surface-bone" : "bg-carbon"]}
  data-surface={surface}
>
  <div class:list={["page-section-inner", width === "prose" && "page-section-prose"]}>
    <SectionHeader id={headingId} title={title} prompt={prompt} lede={lede} level={level} />
    {Astro.slots.has("default") && <div class="page-section-body"><slot /></div>}
  </div>
</section>

<style>
  .page-section {
    padding-block: 4rem;
  }
  @media (min-width: 64rem) {
    .page-section {
      padding-block: 6rem;
    }
  }
  .page-section[data-surface="carbon"] {
    color: var(--color-bone);
  }
  .page-section-inner {
    max-width: 80rem;
    margin-inline: auto;
    padding-inline: 1rem;
  }
  @media (min-width: 40rem) {
    .page-section-inner {
      padding-inline: 1.5rem;
    }
  }
  .page-section-body {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    margin-top: 2rem;
    min-width: 0;
  }
  @media (min-width: 64rem) {
    .page-section-body {
      margin-top: 2.5rem;
    }
  }
  .page-section-prose .page-section-body {
    max-width: 48rem;
  }

  /* A nested section is a sub-block of its parent: no second gutter, a smaller top gap. */
  .page-section .page-section {
    padding-block: 1rem 0;
  }
  .page-section .page-section .page-section-inner {
    padding-inline: 0;
  }
</style>
