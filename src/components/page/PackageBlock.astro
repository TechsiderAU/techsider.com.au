---
// One launch package in full (spec §8.3 block 4, §4.5, §4.6): the solution page's generic
// package, and the body of each launch-package tab. Every block carries data-package-tab and
// data-package-status="launch": CI check 10 fails any tab or full block for another status.
// Ids: blockId = pkg.id + idSuffix on the <section>, `${blockId}-heading` on its heading and
// `${blockId}-onshore-note` on the onshore note. Inside a TabPanel, which owns the bare package
// id, pass idSuffix "-block" so the ids stay unique.
// Onshore scope rule (spec §3.2): ONSHORE_PILLAR only when pkg.onshore; otherwise PROCESSING_NOTE,
// linking to this block's onshore note.
import Notice from "./Notice.astro";
import { ONSHORE_PILLAR, PACKAGED_OFFER_DISCLAIMER, PROCESSING_NOTE } from "../../lib/fixed-copy.ts";
import type { PackageView } from "../../lib/views/offer.ts";

interface Props {
  pkg: PackageView;
  standardInclusions: string[];
  headingLevel?: 3 | 4;
  idSuffix?: string;
}

const { pkg, standardInclusions, headingLevel = 3, idSuffix = "" } = Astro.props;
const blockId = `${pkg.id}${idSuffix}`;
const headingId = `${blockId}-heading`;
---
<section id={blockId} class="package-block" aria-labelledby={headingId} data-package-tab data-package-status="launch">
  {headingLevel === 4 ? (
    <h4 id={headingId} class="package-heading">{pkg.name}</h4>
  ) : (
    <h3 id={headingId} class="package-heading">{pkg.name}</h3>
  )}
  <dl class="package-facts">
    <div class="package-fact package-fact-wide">
      <dt>For</dt>
      <dd>{pkg.forWhom}</dd>
    </div>
    <div class="package-fact package-fact-wide">
      <dt>Scope</dt>
      <dd>{pkg.scope}</dd>
    </div>
    <div class="package-fact">
      <dt>Included</dt>
      <dd><ul>{pkg.inclusions.map((item) => <li>{item}</li>)}</ul></dd>
    </div>
    <div class="package-fact">
      <dt>Every package includes</dt>
      <dd><ul>{standardInclusions.map((item) => <li>{item}</li>)}</ul></dd>
    </div>
    <div class="package-fact">
      <dt>Your time</dt>
      <dd>{pkg.clientTime}</dd>
    </div>
    <div class="package-fact">
      <dt>Timeline</dt>
      <dd>{pkg.timeline}</dd>
    </div>
    <div class="package-fact">
      <dt>Out of scope</dt>
      <dd><ul>{pkg.outOfScope.map((item) => <li>{item}</li>)}</ul></dd>
    </div>
    <div class="package-fact">
      <dt>Go/no-go gate</dt>
      <dd>{pkg.gate}</dd>
    </div>
    {pkg.precondition && (
      <div class="package-fact package-fact-wide">
        <dt>Precondition</dt>
        <dd>{pkg.precondition}</dd>
      </div>
    )}
    <div id={`${blockId}-onshore-note`} class="package-fact package-fact-wide" data-onshore-note>
      <dt>Onshore note</dt>
      <dd>{pkg.onshoreNote}</dd>
    </div>
  </dl>
  {pkg.onshore ? (
    <p class="package-pillar" data-onshore-pillar data-onshore="true">{ONSHORE_PILLAR}</p>
  ) : (
    <p class="package-pillar" data-processing-note><a href={`#${blockId}-onshore-note`}>{PROCESSING_NOTE}</a></p>
  )}
  <Notice text={PACKAGED_OFFER_DISCLAIMER} />
</section>

<style>
  /* Carbon by default; .surface-bone swaps the hairline, muted and accent tokens (spec §6.1). */
  .package-block {
    --package-line: var(--color-graphite);
    --package-muted: var(--color-muted);
    --package-accent: var(--color-acid);
    display: grid;
    gap: 1.25rem;
    min-width: 0;
  }
  :global(.surface-bone) .package-block {
    --package-line: var(--color-bone-line);
    --package-muted: var(--color-muted-dark);
    --package-accent: var(--color-acid-deep);
  }
  .package-heading {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.25;
    overflow-wrap: anywhere;
  }
  /* In a tab panel the package name is already the tab (or the accordion button, or the
     panel's own h3 without JavaScript), so the block's heading stays for screen readers only. */
  :global(.tab-panel) .package-heading {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  /* Row rules on carbon; a hairline cell grid on bone only (spec §6.4). */
  .package-facts {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    margin: 0;
  }
  .package-fact {
    min-width: 0;
    padding: 1rem 0;
    border-top: 1px solid var(--package-line);
  }
  :global(.surface-bone) .package-facts {
    border-top: 1px solid var(--package-line);
    border-left: 1px solid var(--package-line);
  }
  :global(.surface-bone) .package-fact {
    padding: 1rem;
    border-top: 0;
    border-right: 1px solid var(--package-line);
    border-bottom: 1px solid var(--package-line);
  }
  @media (min-width: 48rem) {
    .package-facts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 1.5rem;
    }
    :global(.surface-bone) .package-facts {
      column-gap: 0;
    }
    .package-fact-wide {
      grid-column: 1 / -1;
    }
  }
  .package-fact dt {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--package-muted);
  }
  .package-fact dd {
    margin: 0.375rem 0 0;
    line-height: 1.55;
    overflow-wrap: anywhere;
  }
  .package-fact ul {
    margin: 0;
    padding-left: 1.125rem;
    list-style: square;
  }
  .package-fact li + li {
    margin-top: 0.25rem;
  }
  .package-pillar {
    margin: 0;
    padding-left: 0.75rem;
    border-left: 3px solid var(--package-accent);
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 600;
    overflow-wrap: anywhere;
  }
  .package-pillar a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: inherit;
    text-decoration: underline;
    text-decoration-color: var(--package-muted);
    text-underline-offset: 3px;
  }
  .package-pillar a:hover {
    text-decoration-color: currentColor;
    text-decoration-thickness: 2px;
  }
</style>
