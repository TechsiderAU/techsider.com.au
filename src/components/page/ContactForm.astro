---
// The enquiry form (spec §10.2). Without JavaScript it is a plain HTML POST to the form provider's
// endpoint, which redirects to /contact/sent/. With it, src/scripts/contact-form.ts preselects
// ?industry= and ?interest=, shows each error under its field and in the summary, and sends the same
// fields by fetch (see that file).
// Provider-agnostic (Phase E, blueprint decision 1): the contact data names the provider's own
// fields. The redirect field, when the provider takes one, carries /contact/sent/'s absolute URL;
// the hidden fields go with every enquiry (Formspark's _append=false keeps the enquiry out of the
// redirect URL); the honeypot carries the name the provider's spam filter reads. The form renders
// only while /contact/sent/ is shown, so the provider never redirects to a missing page.
// Native validation stops an incomplete enquiry in the browser: every field is required, the
// email is type="email", the message has maxlength="1000", and fields carry autocomplete where
// one applies. Each field has an empty, hidden error line for the script to fill, carrying its words
// (data-missing, data-invalid), and the summary above the fields is a polite live region, empty
// until the script reports, carrying its lines (data-say-*). Spam defence needs no
// JavaScript: a honeypot input that its display:none wrapper hides from everyone (tabindex="-1",
// autocomplete="off"), plus the provider's own filtering.
// The collection notice sits directly above the submit button. It reads the same contact data as
// the Trust page's sub-processor table, so the two can't disagree. The consent and the notice both
// link to the published privacy policy or the contact page's factual enquiry-handling notice.
// The separate legal draft remains unpublished until its review.
import type { ContactData } from "../../content/page-schemas";
import type { SiteContext } from "../../lib/site";
import { EXTRA_INTERESTS, MESSAGE_PLACEHOLDER, ORG_SIZES } from "../../lib/fixed-copy";
import { FIELD_ERRORS, FORM_MESSAGES, MESSAGE_MAX, type EnquiryField } from "../../lib/contact-form";

interface Props {
  contact: ContactData;
  site: SiteContext;
}

const { contact, site } = Astro.props;
const endpoint = contact.formEndpoint;
if (endpoint === null) {
  throw new Error("ContactForm: contact.formEndpoint is null; the contact page shows the email address instead");
}
const privacyHref = site.page("privacy").href ?? "#enquiry-privacy";
const privacyLabel = site.page("privacy").href === null ? "enquiry privacy notice" : "privacy policy";
const { formProvider, emailProvider } = contact;
if (formProvider === null) {
  throw new Error("ContactForm: contact.formProvider is null; the collection notice names the form provider, so the form needs one (spec §10.2)");
}
const sent = site.page("sent").href;
if (sent === null) {
  throw new Error("ContactForm: /contact/sent/ isn't shown, so the form provider would redirect to a missing page. Put it live in nav.ts with the form endpoint (spec §10.2)");
}
// The provider's hidden fields, in order: the redirect (an absolute URL: the provider sends the
// browser there from its own origin), then the fixed values.
const hidden: [string, string][] = [
  ...(contact.redirectField === null ? [] : [[contact.redirectField, new URL(sent, Astro.site).href] as [string, string]]),
  ...Object.entries(contact.hiddenFields),
];
/** An error line's words, for the script to show (an attribute left undefined isn't rendered). */
const words = (name: EnquiryField) => ({ "data-missing": FIELD_ERRORS[name].missing, "data-invalid": FIELD_ERRORS[name].invalid });
const selects: { id: string; name: EnquiryField; label: string; options: { value: string; label: string }[] }[] = [
  {
    id: "contact-industry",
    name: "industry",
    label: "Industry",
    options: [...site.industries.map((i) => ({ value: i.id, label: i.shortName })), { value: "other", label: "Other" }],
  },
  {
    id: "contact-size",
    name: "size",
    label: "Organisation size",
    options: ORG_SIZES.map((size) => ({ value: size, label: size })),
  },
  {
    id: "contact-interest",
    name: "interest",
    label: "Interest",
    options: [
      ...site.solutions.map((s) => ({ value: s.id, label: s.shortName })),
      ...EXTRA_INTERESTS.map((e) => ({ value: e.id, label: e.label })),
    ],
  },
];
---
<form method="post" action={endpoint} class="contact-form" data-contact-form data-sent={sent} data-submit-mode={contact.submitMode ?? "ajax"}>
  {hidden.map(([name, value]) => <input type="hidden" name={name} value={value} />)}
  <div class="contact-intro">
    <p class="contact-form-note">All fields are required.</p>
    <div
      class="contact-summary"
      data-form-summary
      aria-live="polite"
      data-say-invalid={FORM_MESSAGES.invalid}
      data-say-sending={FORM_MESSAGES.sending}
      data-say-unconfirmed={FORM_MESSAGES.unconfirmed}
    ></div>
  </div>
  <div class="contact-fields">
    <div class="contact-field">
      <label for="contact-name" class="contact-label">Name</label>
      <input id="contact-name" name="name" type="text" autocomplete="name" required class="contact-control" />
      <p id="contact-name-error" class="contact-error" data-error-for="name" {...words("name")} hidden></p>
    </div>
    <div class="contact-field">
      <label for="contact-email" class="contact-label">Work email</label>
      <input id="contact-email" name="email" type="email" autocomplete="email" required class="contact-control" />
      <p id="contact-email-error" class="contact-error" data-error-for="email" {...words("email")} hidden></p>
    </div>
    <div class="contact-field">
      <label for="contact-organisation" class="contact-label">Organisation</label>
      <input id="contact-organisation" name="organisation" type="text" autocomplete="organization" required class="contact-control" />
      <p id="contact-organisation-error" class="contact-error" data-error-for="organisation" {...words("organisation")} hidden></p>
    </div>
    {selects.map((select) => (
      <div class="contact-field">
        <label for={select.id} class="contact-label">{select.label}</label>
        <span class="contact-select">
          <select id={select.id} name={select.name} required class="contact-control">
            <option value="">Choose one</option>
            {select.options.map((option) => <option value={option.value}>{option.label}</option>)}
          </select>
        </span>
        <p id={`${select.id}-error`} class="contact-error" data-error-for={select.name} {...words(select.name)} hidden></p>
      </div>
    ))}
    <div class="contact-field contact-field-wide">
      <label for="contact-message" class="contact-label">Message</label>
      <textarea
        id="contact-message"
        name="message"
        rows="6"
        maxlength={MESSAGE_MAX}
        placeholder={MESSAGE_PLACEHOLDER}
        required
        aria-describedby="contact-message-hint"
        class="contact-control contact-textarea"
      ></textarea>
      <p id="contact-message-hint" class="contact-hint">Up to {MESSAGE_MAX.toLocaleString("en-AU")} characters.</p>
      <p id="contact-message-error" class="contact-error" data-error-for="message" {...words("message")} hidden></p>
    </div>
    <div class="contact-field contact-field-wide">
      <label for="contact-discovery" class="contact-label">How did you find us? (optional)</label>
      <span class="contact-select">
        <select id="contact-discovery" name="discovery" class="contact-control">
          <option value="">Prefer not to say</option>
          <option value="Google Search">Google Search</option>
          <option value="Bing Search">Bing Search</option>
          <option value="ChatGPT">ChatGPT</option>
          <option value="Microsoft Copilot">Microsoft Copilot</option>
          <option value="Other AI assistant">Other AI assistant</option>
          <option value="LinkedIn">LinkedIn</option>
          <option value="Referral">Referral</option>
          <option value="Other">Other</option>
        </select>
      </span>
    </div>
  </div>
  <div class="contact-field">
    <label for="contact-consent" class="contact-consent">
      <input id="contact-consent" name="consent" type="checkbox" value="yes" required class="contact-checkbox" />
      <span>I agree to Techsider handling this enquiry as the <a href={privacyHref} class="contact-link">{privacyLabel}</a> describes.</span>
    </label>
    <p id="contact-consent-error" class="contact-error" data-error-for="consent" {...words("consent")} hidden></p>
  </div>
  <div data-honeypot style="display:none">
    <label for="contact-website">Website</label>
    <input id="contact-website" name={contact.honeypotField} type="text" tabindex="-1" autocomplete="off" />
  </div>
  <p class="contact-notice" data-collection-notice>Your enquiry is sent via {formProvider.name} to our {emailProvider.name} mailbox. See our <a href={privacyHref} class="contact-link">{privacyLabel}</a>.</p>
  {contact.submitMode === "native" && <p id="contact-submit-hint" class="contact-form-note">After sending, complete {formProvider.name}'s spam check to finish your enquiry.</p>}
  <button type="submit" class="btn btn-primary contact-submit" aria-describedby={contact.submitMode === "native" ? "contact-submit-hint" : undefined}>Send enquiry</button>
</form>
{privacyHref === "#enquiry-privacy" && (
  <section id="enquiry-privacy" class="contact-privacy" aria-labelledby="enquiry-privacy-heading">
    <h3 id="enquiry-privacy-heading">Enquiry privacy notice</h3>
    <p>We collect the details you enter to respond to your enquiry and discuss the work you ask about. {formProvider.name} processes your submission and emails it to our {emailProvider.name} mailbox.</p>
    <p>These services may process information outside Australia. Their storage countries are not yet confirmed. We keep enquiries while needed to handle the conversation. To request access, correction or deletion, email {site.email}.</p>
  </section>
)}

<script>
  import { initContactForm } from "../../scripts/contact-form";
  for (const form of document.querySelectorAll<HTMLFormElement>("[data-contact-form]")) initContactForm(form);
</script>

<style>
  /* Written for bone, the contact page's reading surface (spec §6.1): carbon text, muted-dark
     secondary text, 1px muted-dark input borders that turn carbon on focus beside the focus ring.
     An error is blocked-deep text on bone (a listed pair) beside its field, never colour alone:
     the words say what is wrong, and the control carries aria-invalid. */
  .contact-form {
    display: grid;
    gap: 1.5rem;
    min-width: 0;
  }
  .contact-privacy {
    display: grid;
    gap: 0.75rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-bone-line);
    color: var(--color-muted-dark);
    font-size: 0.9375rem;
    line-height: 1.6;
  }
  .contact-privacy p,
  .contact-privacy h3 {
    margin: 0;
  }
  .contact-privacy h3 {
    font-size: 1.0625rem;
    color: var(--color-carbon);
  }
  .contact-form-note,
  .contact-hint,
  .contact-notice {
    margin: 0;
    color: var(--color-muted-dark);
  }
  .contact-form-note,
  .contact-notice {
    font-size: 0.9375rem;
    line-height: 1.5;
  }
  .contact-hint {
    font-size: 0.8125rem;
  }
  .contact-error {
    margin: 0;
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.4;
    color: var(--color-blocked-deep);
  }
  /* The summary is in the page from the start, so screen readers hear what the script writes to it,
     but it takes no room until then. */
  .contact-summary:not(:empty) {
    display: grid;
    gap: 0.5rem;
    margin-top: 1rem;
    padding: 1rem 1.25rem;
    color: var(--color-carbon);
    border: 2px solid var(--color-carbon);
    border-radius: 6px;
  }
  .contact-summary[data-state="invalid"] {
    border-color: var(--color-blocked-deep);
  }
  .contact-summary :global(p) {
    margin: 0;
    font-weight: 600;
    line-height: 1.5;
  }
  .contact-summary :global(ul) {
    display: grid;
    margin: 0;
    padding-left: 1.25rem;
    list-style: disc;
  }
  .contact-summary :global(a) {
    display: inline-flex;
    align-items: center;
    min-height: 45px; /* Keeps the 44px tap target clear of fractional browser rounding. */
    color: var(--color-blocked-deep);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .contact-fields {
    display: grid;
    gap: 1.25rem;
  }
  @media (min-width: 40rem) {
    .contact-fields {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .contact-field-wide {
      grid-column: 1 / -1;
    }
  }
  .contact-field {
    display: grid;
    gap: 0.375rem;
    min-width: 0;
  }
  .contact-label {
    font-size: 0.9375rem;
    font-weight: 600;
  }
  .contact-control {
    width: 100%;
    min-height: 2.75rem; /* 44px tap target, spec §6.6 */
    padding: 0.5rem 0.75rem;
    font: inherit;
    font-size: 1rem; /* 16px: no zoom-on-focus on iOS */
    line-height: 1.4;
    color: var(--color-carbon);
    background-color: var(--color-bone);
    border: 1px solid var(--color-muted-dark);
    border-radius: 6px;
  }
  .contact-control:focus {
    border-color: var(--color-carbon);
  }
  .contact-control[aria-invalid="true"] {
    border-color: var(--color-blocked-deep);
    box-shadow: inset 0 0 0 1px var(--color-blocked-deep);
  }
  .contact-control::placeholder {
    color: var(--color-muted-dark);
    opacity: 1;
  }
  .contact-textarea {
    min-height: 9rem;
    resize: vertical;
  }
  /* A native select ignores height and padding in WebKit, so it drops its native look and the
     wrapper draws the arrow: a decorative text glyph. Generated content is exposed to assistive
     technology, so the arrow has empty alternative text ("/ """); the first declaration is the
     fallback for browsers without that syntax. */
  .contact-select {
    position: relative;
    display: block;
  }
  .contact-select select {
    appearance: none;
    padding-right: 2.25rem;
  }
  .contact-select::after {
    content: "▾";
    content: "▾" / "";
    position: absolute;
    top: 50%;
    right: 0.875rem;
    transform: translateY(-50%);
    font-family: var(--font-mono);
    color: var(--color-carbon);
    pointer-events: none;
  }
  /* The whole consent row is the checkbox's label, so the tap target is the row (44px high). */
  .contact-consent {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    min-height: 2.75rem;
    padding-block: 0.625rem;
    line-height: 1.5;
    cursor: pointer;
  }
  .contact-checkbox {
    flex: none;
    width: 1.5rem;
    height: 1.5rem;
    margin: 0;
    accent-color: var(--color-carbon);
  }
  .contact-link {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .contact-link:hover {
    text-decoration-thickness: 2px;
  }
  .contact-submit {
    justify-self: start;
    min-width: 10rem;
    border: 0;
    cursor: pointer;
  }
</style>
