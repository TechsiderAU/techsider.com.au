---
import { visibleGroups, noJsLinks, resolveCta, CTAS, isPreview } from "../../data/nav";

const preview = isPreview();
const groups = visibleGroups(preview);
const basic = noJsLinks(preview);
const demo = resolveCta(CTAS.demo, preview);
const talk = resolveCta(CTAS.talk, preview);
const path = Astro.url.pathname;
const current = path.endsWith("/") ? path : `${path}/`;
const isCurrent = (href: string) => (href === current ? "page" : undefined);
---
<header class="site-header sticky top-0 z-50 border-b border-bone-line surface-bone">
  <div class="mx-auto flex h-16 max-w-7xl items-center gap-3 px-4 sm:gap-6 sm:px-6">
    <a href="/" class="inline-flex min-h-11 shrink-0 items-center rounded" aria-label="Techsider home">
      <img src="/logo-on-bone.svg" alt="" width="160" height="25" class="h-5 w-auto sm:h-6" />
    </a>

    <nav aria-label="Main" class="hidden lg:block" data-site-nav>
      <ul class="flex items-center gap-1">
        {groups.map((g) => (
          <li class="relative" data-nav-group>
            <div class="flex items-center">
              {g.hubHref ? (
                <a href={g.hubHref} class="nav-label" aria-current={isCurrent(g.hubHref)}>{g.label}</a>
              ) : (
                <span class="nav-label">{g.label}</span>
              )}
              <button type="button" class="nav-toggle" aria-expanded="false" aria-controls={`nav-panel-${g.id}`} hidden data-nav-toggle>
                <span class="sr-only">{g.label} menu</span>
                <svg aria-hidden="true" viewBox="0 0 12 12" width="12" height="12"><path d="M2 4l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.6" /></svg>
              </button>
            </div>
            <div id={`nav-panel-${g.id}`} class:list={["nav-panel bg-graphite", g.layout === "columns" && "nav-panel-wide"]} hidden data-nav-panel>
              <ul class:list={[g.layout === "columns" ? "grid grid-cols-3 gap-x-4 gap-y-1" : "grid gap-1"]}>
                {g.items.map((item) => (
                  <li>
                    <a href={item.path} class="nav-item" aria-current={isCurrent(item.path)}>
                      <span class="nav-item-name">{item.shortName}</span>
                      {item.oneLiner && g.layout === "rows" && <span class="nav-item-desc">{item.oneLiner}</span>}
                    </a>
                  </li>
                ))}
                {g.anchors.map((a) => (
                  <li><a href={a.href} class="nav-item"><span class="nav-item-name">{a.label}</span></a></li>
                ))}
              </ul>
              {g.hubHref && <a href={g.hubHref} class="nav-all">{g.allLabel} <span aria-hidden="true">→</span></a>}
            </div>
          </li>
        ))}
      </ul>
    </nav>

    <div class="ml-auto flex items-center gap-2">
      <a href={demo.href} class="btn btn-secondary hidden lg:inline-flex">{demo.label}</a>
      <!-- Below 360px the bar drops this CTA (it stays in the menu) so 320px reflows without horizontal scroll. -->
      <a href={talk.href} class="btn btn-primary hidden min-[360px]:inline-flex">{talk.label}</a>
      <button type="button" class="menu-toggle lg:hidden" aria-controls="site-menu" aria-expanded="false" hidden data-menu-open>Menu</button>
    </div>
  </div>

  {basic.length > 0 && (
    <nav aria-label="Main (basic)" class="nojs-only border-t border-graphite">
      <ul class="mx-auto flex max-w-7xl flex-wrap gap-x-5 gap-y-1 px-4 py-2 sm:px-6">
        {basic.map((l) => <li><a href={l.href} class="nav-label" aria-current={isCurrent(l.href)}>{l.label}</a></li>)}
      </ul>
    </nav>
  )}

  <dialog id="site-menu" class="site-menu bg-carbon" aria-label="Menu" data-menu>
    <div class="menu-bar">
      <img src="/logo.svg" alt="Techsider" width="160" height="25" class="h-6 w-auto" />
      <button type="button" class="menu-close" data-menu-close><span class="sr-only">Close menu</span><span aria-hidden="true">✕</span></button>
    </div>
    <div class="menu-root" data-menu-root>
      <ul class="menu-rows">
        {groups.map((g) => (
          <li>
            <button type="button" class="menu-row" data-menu-open-panel={g.id}>
              <span>{g.label}</span><span aria-hidden="true">›</span>
            </button>
          </li>
        ))}
      </ul>
      <div class="menu-ctas">
        <a href={demo.href} class="btn btn-secondary">{demo.label}</a>
        <a href={talk.href} class="btn btn-primary">{talk.label}</a>
      </div>
    </div>
    {groups.map((g) => (
      <section class="menu-panel" data-menu-panel={g.id} hidden aria-labelledby={`menu-h-${g.id}`}>
        <button type="button" class="menu-back" data-menu-back={g.id}><span aria-hidden="true">‹</span> Back to menu</button>
        <h2 id={`menu-h-${g.id}`} class="menu-heading" tabindex="-1">{g.label}</h2>
        <ul class="menu-rows">
          {g.items.map((item) => (
            <li>
              <a href={item.path} class="menu-row menu-link" aria-current={isCurrent(item.path)}>
                <span>{item.shortName}</span>
                {item.oneLiner && <span class="menu-desc">{item.oneLiner}</span>}
              </a>
            </li>
          ))}
          {g.anchors.map((a) => (
            <li><a href={a.href} class="menu-row menu-link"><span>{a.label}</span></a></li>
          ))}
        </ul>
        {g.hubHref && <a href={g.hubHref} class="nav-all">{g.allLabel} <span aria-hidden="true">→</span></a>}
      </section>
    ))}
  </dialog>
</header>

<style>
  .site-header > div > div > .btn-secondary { color: var(--color-carbon); box-shadow: inset 0 0 0 1px var(--color-bone-line); }
  .site-header > div > div > .btn-secondary:hover { color: var(--color-acid-deep); }
  .nav-label {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 0.5rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-carbon);
    text-decoration: none;
    border-radius: 4px;
  }
  a.nav-label:hover {
    color: var(--color-acid-deep);
  }
  .nav-label[aria-current="page"] {
    text-decoration: underline;
    text-decoration-color: var(--color-acid-deep);
    text-underline-offset: 6px;
    text-decoration-thickness: 2px;
  }
  .nav-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    margin-left: -0.5rem;
    color: var(--color-muted-dark);
    background: none;
    border: 0;
    border-radius: 4px;
    cursor: pointer;
  }
  .nav-toggle:hover,
  .nav-toggle[aria-expanded="true"] {
    color: var(--color-acid-deep);
  }
  .nav-toggle[aria-expanded="true"] svg {
    transform: rotate(180deg);
  }
  .nav-toggle svg { transition: transform 180ms ease; }
  .nav-panel {
    position: absolute;
    left: 0;
    top: 100%;
    margin-top: 0.5rem;
    width: 22rem;
    padding: 0.75rem;
    background: var(--color-graphite);
    border-radius: 8px;
    box-shadow: 0 16px 40px rgb(0 0 0 / 0.5);
    opacity: 0;
    transform: translateY(-6px);
    pointer-events: none;
    /* Keep text and its background opaque throughout the smooth movement. */
    transition: transform 180ms cubic-bezier(.2, .7, .3, 1);
  }
  .nav-panel[data-nav-open] {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }
  /* Bridge the visual gap so travelling from the label into its panel keeps hover active. */
  .nav-panel::before {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    top: -.5rem;
    height: .5rem;
  }
  @media (prefers-reduced-motion: reduce) {
    .nav-panel, .nav-toggle svg { transition: none; }
  }
  .nav-panel-wide {
    width: 38rem;
  }
  /* B2: the 4th and 5th groups (Resources, About) sit near the right edge, so their panels hang
     from the group's right edge instead: left-aligned, About reaches x=1024 at a 1024px window and
     overflows once a classic scrollbar narrows the layout. Chosen by position, not "last two": in
     production Resources is the only group, and right-aligning it would push its panel off the left. */
  [data-nav-group]:nth-child(n + 4) .nav-panel {
    left: auto;
    right: 0;
  }
  .nav-item {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.125rem;
    min-height: 44px;
    padding: 0.5rem 0.625rem;
    border-radius: 6px;
    text-decoration: none;
  }
  .nav-item:hover {
    background: rgb(11 11 12 / 0.55);
  }
  .nav-item-name {
    color: var(--color-bone);
    font-size: 0.875rem;
    font-weight: 600;
  }
  .nav-item:hover .nav-item-name,
  .nav-item[aria-current="page"] .nav-item-name {
    color: var(--color-acid);
  }
  .nav-item[aria-current="page"] .nav-item-name {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .nav-item-desc {
    color: var(--color-muted);
    font-size: 0.8125rem;
    line-height: 1.35;
  }
  .nav-all {
    display: flex;
    align-items: center;
    gap: 1ch; /* the space before the aria-hidden arrow collapses in a flex row */
    min-height: 44px;
    margin-top: 0.5rem;
    padding: 0.5rem 0.625rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-acid);
    text-decoration: none;
  }
  .menu-panel .nav-all {
    min-height: 48px;
  }
  .menu-toggle {
    min-height: 44px;
    padding: 0 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--color-carbon);
    background: none;
    border: 0;
    border-radius: 6px;
    cursor: pointer;
  }
  dialog.site-menu {
    margin: 0;
    padding: 0;
    width: 100%;
    max-width: none;
    height: 100dvh;
    max-height: none;
    border: 0;
    background: var(--color-carbon);
    color: var(--color-bone);
  }
  dialog.site-menu::backdrop {
    background: var(--color-carbon);
  }
  .menu-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 4rem;
    padding: 0 1rem;
    border-bottom: 1px solid var(--color-graphite);
  }
  .menu-close {
    width: 48px;
    height: 48px;
    font-size: 1.25rem;
    color: var(--color-bone);
    background: none;
    border: 0;
    border-radius: 6px;
    cursor: pointer;
  }
  .menu-root {
    display: flex;
    flex-direction: column;
    padding: 0.5rem 1rem 1rem;
  }
  .menu-rows {
    display: grid;
  }
  .menu-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    min-height: 48px;
    padding: 0.5rem 0;
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-bone);
    text-align: left;
    text-decoration: none;
    background: none;
    border: 0;
    border-bottom: 1px solid var(--color-graphite);
    cursor: pointer;
  }
  .menu-link {
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
  }
  .menu-desc {
    font-size: 0.875rem;
    font-weight: 400;
    color: var(--color-muted);
  }
  .menu-ctas {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }
  .menu-ctas .btn {
    min-height: 48px;
  }
  @media (min-height: 560px) {
    .menu-root {
      min-height: calc(100dvh - 4rem);
    }
    .menu-ctas {
      margin-top: auto;
      padding-top: 1.5rem;
    }
  }
  .menu-panel {
    padding: 0.5rem 1rem 1.5rem;
  }
  .menu-back {
    min-height: 48px;
    padding: 0;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--color-acid);
    background: none;
    border: 0;
    cursor: pointer;
  }
  .menu-heading {
    margin: 0.25rem 0 0.5rem;
    font-family: var(--font-display);
    font-stretch: 125%;
    font-weight: 800;
    font-size: 1.5rem;
    text-transform: uppercase;
  }
  .menu-heading:focus:not(:focus-visible) {
    outline: none;
  }
</style>

<script>
  import { initSiteNav } from "../../scripts/site-nav";
  import { initSiteMenu } from "../../scripts/site-menu";
  import { initAnchorScroll } from "../../scripts/anchor-scroll";
  initSiteNav();
  initSiteMenu();
  initAnchorScroll();
</script>
