---
import type { SampleReportData } from "../../content/schemas";
import DataTable from "./DataTable.astro";

interface Props {
  report: SampleReportData;
}

const { report } = Astro.props;
// Spec §9.3: an illustrative report says so on the page; a measured one cites its committed run.
// An in-code measured report without a run fails the build rather than render a bare claim.
if (report.provenance === "measured" && !report.run) {
  throw new Error(`SampleReport "${report.system}": provenance is "measured", but no run path is given`);
}
const label = report.provenance === "measured" ? `Measured run: ${report.run}` : "Illustrative sample: not a real test run";
const RATING_LABEL = { low: "Low", medium: "Medium", high: "High" } as const;
// Targets and results are typed metrics (spec §9.3), shown as value then unit ("90%"), as TracePanel shows its metrics.
const show = (m: { value: number; unit?: string }) => `${m.value}${m.unit ?? ""}`;
// A confidence interval takes its result's unit: "88–95% (95% CI)".
const showCi = (ci: { low: number; high: number; level: number }, unit = "") => `${ci.low}–${ci.high}${unit} (${ci.level}% CI)`;
const thresholdColumns = [
  { key: "metric", label: "Metric" },
  { key: "target", label: "Target" },
  { key: "result", label: "Result" },
  { key: "ci", label: "Confidence interval" },
  { key: "outcome", label: "Outcome" },
];
const thresholdRows = report.thresholds.map((t) => ({
  metric: t.metric,
  target: show(t.target),
  result: show(t.result),
  ci: showCi(t.ci, t.result.unit),
  outcome: t.pass ? "Pass" : "Fail",
}));
// Spec §9.1: the same test set on two model versions.
const { regression } = report;
const regressionColumns = [
  { key: "metric", label: "Metric" },
  { key: "baseline", label: regression.baseline },
  { key: "candidate", label: regression.candidate },
];
const regressionRows = regression.rows.map((row) => ({
  metric: row.metric,
  baseline: show(row.baseline),
  candidate: show(row.candidate),
}));
---
<article class="sample-report" data-sample-report data-provenance={report.provenance}>
  <header class="sample-header">
    <h2 class="sample-title">Sample evaluation report</h2>
    <p class="sample-caption" data-sample-caption>Sample report: Techsider testing its own demo system, so not independent.</p>
    <p class="sample-provenance"><span aria-hidden="true" class="sample-bracket">[</span><span data-provenance-label>{label}</span><span aria-hidden="true" class="sample-bracket">]</span></p>
  </header>
  <dl class="sample-meta">
    <div>
      <dt>System</dt>
      <dd>{report.system}</dd>
    </div>
    <div>
      <dt>Sample size</dt>
      <dd>n = {report.n}</dd>
    </div>
    <div>
      <dt>Method</dt>
      <dd>{report.method}</dd>
    </div>
    <div>
      <dt>Ground truth</dt>
      <dd>{report.groundTruth}</dd>
    </div>
    <div>
      <dt>Inter-rater agreement</dt>
      <dd>{report.interRater.statistic}: {show(report.interRater.value)}</dd>
    </div>
    <div>
      <dt>Failures mapped to</dt>
      <dd>{report.framework}</dd>
    </div>
  </dl>
  <section class="sample-section">
    <h3 class="sample-subhead">Thresholds</h3>
    <DataTable caption="Each threshold, its target and the result" columns={thresholdColumns} rows={thresholdRows} rowHeader="metric" />
  </section>
  <section class="sample-section">
    <h3 class="sample-subhead">Failures found</h3>
    <ol class="sample-failures">
      {report.failures.map((f) => (
        <li class="sample-failure" data-rating={f.rating}>
          <p class="sample-failure-head">
            <span class="sample-failure-id">{f.id}</span>{" "}
            <span class="sample-failure-rating">Rating: {RATING_LABEL[f.rating]}</span>{" "}
            <span class="sample-failure-level">Framework level: {f.frameworkLevel}</span>
          </p>
          <p>{f.description}</p>
        </li>
      ))}
    </ol>
  </section>
  <section class="sample-section">
    <h3 class="sample-subhead">Model-change regression</h3>
    <DataTable caption={`The same test set on ${regression.baseline} and ${regression.candidate}`} columns={regressionColumns} rows={regressionRows} rowHeader="metric" />
  </section>
</article>

<style>
  .sample-report {
    --sr-muted: var(--color-muted);
    --sr-line: var(--color-graphite);
    --sr-bar: var(--color-acid);
    display: grid;
    gap: 2rem;
    max-width: 56rem;
  }
  :global(.surface-bone) .sample-report {
    --sr-muted: var(--color-muted-dark);
    --sr-line: var(--color-bone-line);
    --sr-bar: var(--color-acid-deep);
  }
  :global(.surface-bone :is(.bg-carbon, .bg-graphite)) .sample-report {
    --sr-muted: var(--color-muted);
    --sr-line: var(--color-graphite);
    --sr-bar: var(--color-acid);
  }
  .sample-header {
    display: grid;
    gap: 0.75rem;
  }
  .sample-title {
    margin: 0;
    font-size: clamp(1.5rem, 1.25rem + 1.25vw, 2.25rem);
    font-weight: 600;
    line-height: 1.15;
  }
  /* The caption is part of the report, not small print: body size, full-contrast text. */
  .sample-caption {
    margin: 0;
    padding-left: 0.875rem;
    border-left: 3px solid var(--sr-bar);
    font-family: var(--font-mono);
    font-size: 1rem;
    line-height: 1.5;
  }
  /* Provenance (spec §9.3), in full-contrast text; only the decorative brackets take the accent. */
  .sample-provenance {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 700;
    overflow-wrap: anywhere;
  }
  .sample-bracket {
    color: var(--sr-bar);
  }
  .sample-meta {
    display: grid;
    gap: 1rem;
    margin: 0;
  }
  @media (min-width: 48rem) {
    .sample-meta {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .sample-meta div {
    padding-top: 0.75rem;
    border-top: 1px solid var(--sr-line);
  }
  .sample-meta dt,
  .sample-failure-id,
  .sample-failure-rating,
  .sample-failure-level {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--sr-muted);
  }
  .sample-meta dd {
    margin: 0.25rem 0 0;
    overflow-wrap: anywhere;
  }
  .sample-section {
    display: grid;
    gap: 1rem;
  }
  .sample-subhead {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 600;
  }
  .sample-failures {
    display: grid;
  }
  .sample-failure {
    display: grid;
    gap: 0.25rem;
    padding-block: 0.875rem;
    border-top: 1px solid var(--sr-line);
  }
  .sample-failure p {
    margin: 0;
    overflow-wrap: anywhere;
  }
  .sample-failure-head {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
  }
  .sample-failure-rating {
    font-weight: 700;
    color: inherit;
  }
</style>
