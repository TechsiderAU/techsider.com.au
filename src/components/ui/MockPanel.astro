---
import type { MockPanelData } from "../../content/schemas";

interface Props {
  panel: MockPanelData;
}

const { panel } = Astro.props;
---
<figure class="mock-panel" data-mock-panel>
  <div class="mock-window bg-graphite">
    <div class="mock-titlebar">
      <span class="mock-dots" aria-hidden="true"><span></span><span></span><span></span></span>
      <p class="mock-title">{panel.title}</p>
    </div>
    <div class="mock-body">
      <dl class="mock-fields">
        {panel.fields.map((f) => (
          <div class="mock-field">
            <dt>{f.label}</dt>
            {f.redacted ? (
              <dd data-redacted><span aria-hidden="true">••••</span> (redacted)</dd>
            ) : (
              <dd>{f.value}</dd>
            )}
          </div>
        ))}
      </dl>
      {panel.chips.length > 0 && (
        <ul class="mock-chips">
          {panel.chips.map((c) => (
            <li class="mock-chip" data-status={c.status}>
              <span class="mock-chip-status"><span aria-hidden="true">[</span>{c.status}<span aria-hidden="true">]</span><span class="sr-only">:</span></span>{" "}
              <span>{c.text}</span>
            </li>
          ))}
        </ul>
      )}
      {panel.citations.length > 0 && (
        <div class="mock-citations">
          <p class="mock-label">Sources</p>
          <ol>
            {panel.citations.map((c) => (
              <li>
                {c.href ? <a href={c.href} class="mock-source">{c.source}</a> : <span class="mock-source">{c.source}</span>}{" "}
                <span class="mock-clause">{c.clause}</span>
              </li>
            ))}
          </ol>
        </div>
      )}
      {panel.decision && (
        <div class="mock-decision">
          <p class="sr-only">Decision buttons shown for illustration: {panel.decision.approve}, {panel.decision.reject}.</p>
          <span class="mock-btn mock-btn-approve" aria-hidden="true">{panel.decision.approve}</span>
          <span class="mock-btn mock-btn-reject" aria-hidden="true">{panel.decision.reject}</span>
        </div>
      )}
    </div>
  </div>
  <figcaption class="mock-caption">Illustrative interface, fictional data</figcaption>
</figure>

<style>
  .mock-panel {
    --mock-caption: var(--color-muted);
    margin: 0;
    max-width: 40rem;
  }
  :global(.surface-bone) .mock-panel {
    --mock-caption: var(--color-muted-dark);
  }
  :global(.surface-bone :is(.bg-carbon, .bg-graphite)) .mock-panel {
    --mock-caption: var(--color-muted);
  }
  /* The window is a dark island on any surface: bone text, lime ring (global.css surface-bone rule). */
  .mock-window {
    color: var(--color-bone);
    border: 1px solid var(--color-graphite);
    border-radius: 8px;
    overflow: hidden;
  }
  .mock-titlebar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.625rem 1rem;
    background: var(--color-carbon);
  }
  .mock-dots {
    display: inline-flex;
    gap: 0.375rem;
  }
  .mock-dots span {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 999px;
    background: var(--color-graphite);
  }
  .mock-title {
    margin: 0;
    min-width: 0;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-muted);
    overflow-wrap: anywhere;
  }
  .mock-body {
    display: grid;
    gap: 1.25rem;
    padding: 1.25rem 1rem;
  }
  .mock-fields {
    display: grid;
    gap: 0.625rem;
    margin: 0;
  }
  .mock-field {
    display: grid;
    gap: 0.125rem;
  }
  @media (min-width: 30rem) {
    .mock-field {
      grid-template-columns: minmax(8rem, 35%) 1fr;
      gap: 1rem;
    }
  }
  .mock-field dt {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-muted);
  }
  .mock-field dd {
    margin: 0;
    font-size: 0.9375rem;
    overflow-wrap: anywhere;
  }
  .mock-field dd[data-redacted] {
    font-family: var(--font-mono);
    color: var(--color-muted);
  }
  .mock-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .mock-chip {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem;
    padding: 0.375rem 0.625rem;
    font-size: 0.8125rem;
    background: var(--color-carbon);
    border-radius: 4px;
  }
  .mock-chip-status {
    font-family: var(--font-mono);
    font-weight: 700;
  }
  .mock-chip[data-status="ok"] .mock-chip-status {
    color: var(--color-ok);
  }
  .mock-chip[data-status="review"] .mock-chip-status {
    color: var(--color-review);
  }
  .mock-chip[data-status="blocked"] .mock-chip-status {
    color: var(--color-blocked);
  }
  .mock-label {
    margin: 0 0 0.25rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-muted);
  }
  .mock-citations li {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    column-gap: 0.75rem;
    min-height: 2.75rem;
    border-top: 1px solid var(--color-carbon);
    font-size: 0.875rem;
  }
  .mock-source {
    font-weight: 600;
    overflow-wrap: anywhere;
  }
  a.mock-source {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--color-acid);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  a.mock-source:hover {
    text-decoration-thickness: 2px;
  }
  .mock-clause {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-muted);
  }
  .mock-decision {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .mock-btn {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0 0.875rem;
    border-radius: 6px;
    font-size: 0.875rem;
    font-weight: 600;
    cursor: default;
    user-select: none;
  }
  .mock-btn-approve {
    background: var(--color-acid);
    color: var(--color-carbon);
  }
  .mock-btn-reject {
    color: var(--color-bone);
    box-shadow: inset 0 0 0 1px var(--color-muted);
  }
  .mock-caption {
    margin-top: 0.625rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--mock-caption);
  }
</style>
