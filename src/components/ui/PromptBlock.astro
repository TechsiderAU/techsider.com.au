---
// Closing CTA as a terminal prompt (spec §6.4): set inside the content width (48rem, centred),
// never a full-width band. The prompt line is decorative; the link is the real control.
// The block is a carbon island (bg-carbon), so on a bone section it keeps the lime focus ring.
interface Props {
  command: string;
  args?: string;
  label: string;
  href: string;
  title?: string;
  body?: string;
}

const { label, href, title = "Start with one workflow.", body } = Astro.props;
---
<div class="prompt-block bg-carbon scanlines" data-prompt-block>
  <div><p class="closing-title">{title}</p>{body && <p class="closing-body">{body}</p>}</div>
  <a href={href} class="btn btn-primary">{label}</a>
</div>

<style>
  .closing-body { max-width: 52ch; margin: .75rem 0 0; color: var(--color-muted); line-height: 1.6; }
  .closing-title { margin: 0; max-width: 24ch; font-size: clamp(1.5rem, 1rem + 1vw, 2rem); font-weight: 600; line-height: 1.15; letter-spacing: -.025em; }
  .prompt-block {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 1.5rem;
    width: 100%;
    max-width: 80rem;
    margin-inline: auto;
    padding: 1.5rem;
    color: var(--color-bone);
    border: 1px solid var(--color-graphite);
    border-radius: 8px;
  }
  .prompt-line {
    margin: 0;
    min-width: 0;
    font-family: var(--font-mono);
    font-size: 0.9375rem;
    overflow-wrap: anywhere;
  }
  .prompt-caret {
    color: var(--color-acid);
  }
  .prompt-args {
    color: var(--color-muted);
  }
</style>
