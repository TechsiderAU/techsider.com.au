---
// One panel of a <Tabs> group. Server-rendered as a plain section with a readable id and a
// visible heading, so it reads as a stacked section without JavaScript. src/scripts/tabs.ts
// turns it into a tab panel (768px and up) or an accordion item (below 768px).
interface Props {
  id: string;
  label: string;
}

const { id, label } = Astro.props;
---
<section class="tab-panel" id={id} data-tab-panel data-tab-label={label} aria-labelledby={`${id}-heading`}>
  <h3 id={`${id}-heading`} class="tab-panel-heading">{label}</h3>
  <slot />
</section>

<style>
  .tab-panel-heading {
    font-size: 1.125rem;
    font-weight: 700;
    line-height: 1.3;
    margin-bottom: 0.75rem;
  }
</style>
