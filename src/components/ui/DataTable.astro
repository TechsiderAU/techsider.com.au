---
// One HTML table at every width (spec §8.12; B1 review finding BR-7a). From 768px it lays out as a
// table. Below that, CSS stacks each row into a card: the header row leaves the screen but stays
// in the table for screen readers, and each cell shows its column label above its value. The
// labels are aria-hidden, because the column headers already name each cell, and the explicit
// ARIA roles keep the table semantics that some browsers drop once a table's display changes.
// Every row renders once, so a row id is unique on the page and a #row link lands on its row at
// every width, without JavaScript.
import { cellHref, cellText, checkTable, type Cell } from "../../lib/data-table";

interface Props {
  caption: string;
  columns: { key: string; label: string }[];
  rows: Record<string, Cell>[];
  rowHeader: string;
  rowIds?: string[];
  rowMarker?: `data-${string}`;
}

const { caption, columns, rows, rowHeader, rowIds, rowMarker } = Astro.props;
checkTable({ caption, columns, rows, rowHeader, rowIds, rowMarker });
// The row marker renders as a bare attribute on every body row (data-regulatory-row), for CI checks
// and tests. Each row spreads a fresh object: Astro writes its scope class into a spread object,
// so one shared object would collect another copy of that class on every row.
const markerOf = () => (rowMarker ? { [rowMarker]: "" } : {});
---
<div class="data-table" data-data-table>
  <table class="dt-table" role="table">
    <caption>{caption}</caption>
    <thead role="rowgroup">
      <tr role="row">
        {columns.map((c) => <th scope="col" role="columnheader">{c.label}</th>)}
      </tr>
    </thead>
    <tbody role="rowgroup">
      {rows.map((row, i) => (
        <tr role="row" id={rowIds?.[i]} {...markerOf()}>
          {columns.map((c) => {
            const href = cellHref(row[c.key]);
            const value = href === null ? cellText(row[c.key]) : <a href={href} class="dt-link">{cellText(row[c.key])}</a>;
            return c.key === rowHeader ? (
              <th scope="row" role="rowheader">{value}</th>
            ) : (
              <td role="cell"><span class="dt-label" aria-hidden="true">{c.label}</span>{value}</td>
            );
          })}
        </tr>
      ))}
    </tbody>
  </table>
</div>

<style>
  /* Hairlines are graphite on carbon and bone-line on bone (spec §6.1); rows only, no cell grid (§6.4). */
  .data-table {
    --dt-line: var(--color-graphite);
    --dt-muted: var(--color-muted);
    position: relative; /* contains the visually hidden header row below 768px */
  }
  :global(.surface-bone) .data-table {
    --dt-line: var(--color-bone-line);
    --dt-muted: var(--color-muted-dark);
  }
  :global(.surface-bone :is(.bg-carbon, .bg-graphite)) .data-table {
    --dt-line: var(--color-graphite);
    --dt-muted: var(--color-muted);
  }
  .dt-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9375rem;
    line-height: 1.5;
  }
  .dt-table caption {
    margin: 0;
    padding-bottom: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    text-align: left;
    color: var(--dt-muted);
  }
  /* break-word, not anywhere: a word breaks only when it can't fit its column. "anywhere" also lowers
     a cell's min-content width, so an auto-layout table shrinks a short column below its longest word
     and breaks it mid-letter even at 1280px (final review WB-D2). */
  .dt-table th,
  .dt-table td {
    text-align: left;
    vertical-align: top;
    overflow-wrap: break-word;
  }
  .dt-table thead th {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--dt-muted);
  }
  .dt-table tbody th {
    font-weight: 600;
  }
  .dt-label {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--dt-muted);
  }
  /* A link cell is a 44px target (spec §6.6); a cell whose href is null renders as text. */
  .dt-link {
    display: inline-flex;
    align-items: center;
    min-width: 2.75rem;
    min-height: 2.75rem;
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .dt-link:hover {
    text-decoration-thickness: 2px;
  }
  /* Below 768px: every body row is a card, and the header row is visually hidden. */
  @media (width < 48rem) {
    .dt-table,
    .dt-table caption,
    .dt-table tbody,
    .dt-table th,
    .dt-table td {
      display: block;
    }
    .dt-table thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
    .dt-table tbody tr {
      display: grid;
      gap: 0.5rem;
      padding-block: 1rem;
      border-top: 1px solid var(--dt-line);
    }
    .dt-table tbody tr:last-child {
      border-bottom: 1px solid var(--dt-line);
    }
  }
  /* 768px and up: a table with row rules, and no in-cell labels. */
  @media (width >= 48rem) {
    .dt-table th,
    .dt-table td {
      padding: 0.75rem 1rem 0.75rem 0;
      border-bottom: 1px solid var(--dt-line);
    }
    .dt-label {
      display: none;
    }
  }
</style>
