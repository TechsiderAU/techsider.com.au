---
// The ② Knowledge Assistant's static transcript (spec §8.8, §9.1): the `transcript` slot of its
// DemoFrame, complete without JavaScript, and the demo's final state after a replay or a skip.
// Every scenario in order: its heading lines, then each turn (the question, the retrieved passages
// with their illustrative scores, the outcome line, the answer with a link per citation, what the
// test caught, the trace), then its sources and the corpus attribution the licence asks for.
// The replay (src/scripts/demo/assistant.ts) draws the same structure with the same classes and
// the same words (src/lib/assistant-copy.ts), so the styles below are global: they style the
// replay's stage too. Only this transcript holds links and ids.
// - `level`: the scenario titles' heading level, one below the heading the demo sits under.
// - `idPrefix`: starts every source id ("<idPrefix>-<scenario id>-src-<n>"); unique per demo on a page.
import type { AssistantData } from "../../content/schemas.ts";
import { attributionParts } from "../../lib/attribution.ts";
import {
  CAUGHT_LABEL, ILLUSTRATIVE_NOTE, OUTCOME, QUESTION_LABEL, RETRIEVED_LABEL, SOURCES_LABEL,
  chunkCite, metricText, scenarioLabel,
} from "../../lib/assistant-copy.ts";

interface Props {
  data: AssistantData;
  level: 2 | 3 | 4;
  idPrefix: string;
}

const { data, level, idPrefix } = Astro.props;
const Heading = `h${level}` as "h2" | "h3" | "h4";
const total = data.scenarios.length;
const sourceId = (scenario: string, cite: number) => `${idPrefix}-${scenario}-src-${cite}`;
---
<div class="assist" data-assistant-transcript>
  <p class="assist-note">{ILLUSTRATIVE_NOTE}</p>
  {data.scenarios.map((scenario, index) => {
    const kicker = scenarioLabel(index, total);
    return (
      <div class="assist-scenario" data-scenario={scenario.id}>
        <div class="assist-head">
          {kicker !== null && <p class="assist-kicker">{kicker}</p>}
          <Heading class="assist-title">{scenario.title}</Heading>
          <p class="assist-corpus">Corpus: <a href={scenario.corpus.url} class="assist-link">{scenario.corpus.title}</a>, {scenario.corpus.version}</p>
        </div>
        <ol class="assist-turns">
          {scenario.turns.map((turn) => (
            <li class="assist-turn" data-outcome={turn.outcome}>
              <p class="assist-role">{QUESTION_LABEL}</p>
              <p class="assist-q">{turn.question}</p>
              <div class="assist-retrieval">
                <p class="assist-role">{RETRIEVED_LABEL}</p>
                <ol class="assist-chunks">
                  {turn.retrieved.map((chunk) => (
                    <li class="assist-chunk">
                      <span class="assist-score">{metricText(chunk.score)}</span>{" "}
                      <span class="assist-chunk-cite">{chunkCite(chunk.cite)}</span>{" "}
                      <span class="assist-snippet">{chunk.snippet}</span>
                    </li>
                  ))}
                </ol>
              </div>
              <p class="assist-role assist-outcome" data-status={OUTCOME[turn.outcome].status}>{OUTCOME[turn.outcome].label}</p>
              <p class="assist-a">
                {turn.answer.map((segment) => (
                  <Fragment>
                    {segment.text}
                    {segment.cite !== undefined && (
                      <a href={`#${sourceId(scenario.id, segment.cite)}`} class="assist-cite"><span aria-hidden="true">[</span><span class="sr-only">Source </span>{segment.cite}<span aria-hidden="true">]</span></a>
                    )}
                  </Fragment>
                ))}
              </p>
              {turn.caught !== undefined && (
                <p class="assist-caught"><span class="assist-caught-label">{CAUGHT_LABEL}</span> {turn.caught}</p>
              )}
              <ol class="assist-trace">
                {turn.trace.map((step) => (
                  <li class="assist-trace-step">
                    <span class="assist-trace-label">{step.label}</span>{" "}
                    <span class="assist-trace-detail">{step.detail}</span>{" "}
                    <span class="assist-trace-ms">{metricText(step.ms)}</span>
                  </li>
                ))}
              </ol>
            </li>
          ))}
        </ol>
        <div class="assist-sources">
          <p class="assist-role">{SOURCES_LABEL}</p>
          <ol class="assist-source-list">
            {scenario.sources.map((source) => (
              <li id={sourceId(scenario.id, source.cite)} class="assist-source">
                <p class="assist-source-label">[{source.cite}] <a href={source.href} class="assist-link">{source.label}</a></p>
                <p class="assist-source-text">{source.text}</p>
              </li>
            ))}
          </ol>
          <p class="assist-attribution">
            {attributionParts(scenario.corpus.attribution).map((part) =>
              part.kind === "link" ? <a href={part.href} class="assist-link">{part.text}</a> : part.kind === "title" ? <cite>{part.text}</cite> : part.text,
            )}
          </p>
        </div>
      </div>
    );
  })}
</div>

<style>
  /* Global on purpose: the replay's stage (src/scripts/demo/assistant.ts) builds the same classes
     in the browser, and scoped styles would miss its nodes. Every rule is under an assist- class.
     A carbon island (DemoFrame): bone text, muted secondary text, acid marks, graphite hairlines
     and panels, and the status tokens on carbon (spec §6.1). */
  :global(.assist) {
    container-type: inline-size;
    display: grid;
    gap: 2rem;
    min-width: 0;
    overflow-wrap: anywhere;
  }
  :global(.assist-note),
  :global(.assist-kicker),
  :global(.assist-role),
  :global(.assist-corpus),
  :global(.assist-q),
  :global(.assist-a),
  :global(.assist-caught),
  :global(.assist-source-label),
  :global(.assist-source-text),
  :global(.assist-attribution) {
    margin: 0;
  }
  :global(.assist-note),
  :global(.assist-kicker),
  :global(.assist-role) {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--color-muted);
  }
  :global(.assist-scenario) {
    display: grid;
    gap: 1.5rem;
    min-width: 0;
  }
  :global(.assist-head) {
    display: grid;
    gap: 0.375rem;
  }
  :global(.assist-title) {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.3;
  }
  :global(.assist-corpus) {
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--color-muted);
  }
  :global(.assist-turns),
  :global(.assist-chunks),
  :global(.assist-trace),
  :global(.assist-source-list) {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  :global(.assist-turns) {
    display: grid;
    gap: 1.5rem;
    min-width: 0;
  }
  :global(.assist-turn) {
    display: grid;
    gap: 0.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-graphite);
  }
  :global(.assist-q) {
    font-weight: 600;
    line-height: 1.5;
  }
  :global(.assist-retrieval) {
    display: grid;
    gap: 0.375rem;
    padding: 0.625rem 0.75rem;
    background: var(--color-graphite);
    border-radius: 6px;
  }
  :global(.assist-chunk) {
    font-size: 0.8125rem;
    line-height: 1.5;
  }
  :global(.assist-score) {
    font-family: var(--font-mono);
    font-weight: 700;
    color: var(--color-acid);
  }
  :global(.assist-chunk-cite),
  :global(.assist-trace) {
    font-family: var(--font-mono);
    color: var(--color-muted);
  }
  :global(.assist-outcome[data-status="review"]) {
    color: var(--color-review);
  }
  :global(.assist-outcome[data-status="blocked"]) {
    color: var(--color-blocked);
  }
  :global(.assist-a) {
    line-height: 1.6;
  }
  :global(.assist-turn[data-outcome="false-answer-caught"] .assist-a) {
    padding-left: 0.75rem;
    border-left: 2px solid var(--color-blocked);
  }
  :global(.assist-cite) {
    margin-left: 0.125rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-acid);
  }
  :global(a.assist-cite),
  :global(a.assist-link) {
    color: var(--color-acid);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  :global(a.assist-cite:hover),
  :global(a.assist-link:hover) {
    text-decoration-thickness: 2px;
  }
  :global(.assist-caught) {
    font-size: 0.875rem;
    line-height: 1.5;
  }
  :global(.assist-caught-label) {
    font-family: var(--font-mono);
    color: var(--color-blocked);
  }
  :global(.assist-trace) {
    display: grid;
    gap: 0.125rem;
    font-size: 0.75rem;
    line-height: 1.5;
  }
  :global(.assist-trace-label) {
    color: var(--color-acid);
  }
  :global(.assist-trace-ms) {
    color: var(--color-bone);
  }
  :global(.assist-sources) {
    display: grid;
    align-content: start;
    gap: 0.75rem;
    min-width: 0;
  }
  :global(.assist-source-list) {
    display: grid;
    gap: 0.75rem;
  }
  :global(.assist-source) {
    display: grid;
    gap: 0.25rem;
    padding-left: 0.75rem;
    border-left: 2px solid var(--color-graphite);
  }
  :global(.assist-source:target) {
    border-left-color: var(--color-acid);
  }
  :global(.assist-source-label) {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    line-height: 1.5;
  }
  /* A source's link stands alone on its line, so it gets the 44px target (spec §6.6); the
     citation marks and the attribution's links sit inside sentences. */
  :global(.assist-source-label .assist-link) {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
  }
  :global(.assist-source-text) {
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--color-muted);
  }
  :global(.assist-attribution) {
    font-size: 0.75rem;
    line-height: 1.6;
    color: var(--color-muted);
  }
  /* Wide frames put each scenario's sources beside its turns. */
  @container (min-width: 48rem) {
    :global(.assist-scenario) {
      grid-template-columns: minmax(0, 1fr) minmax(14rem, 18rem);
      column-gap: 2rem;
    }
    :global(.assist-head) {
      grid-column: 1 / -1;
    }
  }
</style>
