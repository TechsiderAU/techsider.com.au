---
// The ⑤ demo's compact frame in the ⑤ solution page's hero (spec §8.3, §8.7): what the "What you
// already pay for" checker does, the vendors its dated facts cover and their as-at date, and a link
// to the full tool on its own page, the checker's canonical URL. It is static and loads no script.
// The hero can't hold the checker itself: the vendors' feature texts name "agents", which spec §3.4
// keeps off this mid-market page. It never carries data-checker, which marks a rendered checker.
// The vendor names and the date come from src/data/platform-ai.json through Task 6's checkerView().
import platformAi from "../../data/platform-ai.json";
import { platformAiFile } from "../../content/schemas";
import type { SiteContext } from "../../lib/site";
import { checkerView } from "../../lib/views/checker";

interface Props {
  site: SiteContext;
}

const { site } = Astro.props;
const view = checkerView(platformAiFile.parse(platformAi), site);
const checker = site.page("payFor");
---
<div class="checker-summary" data-checker-summary>
  <p>Tick the software you already pay for. The checker shows the AI each product includes or sells as an add-on, where each vendor says it's processed, and what's left for a build.</p>
  <p>It runs in your browser, so nothing you tick is sent anywhere.</p>
  <p>Vendors covered: {view.vendors.map((group) => group.vendor).join(", ")}.</p>
  <p class="checker-summary-as-at">Vendor facts as at <time datetime={view.asAt.iso}>{view.asAt.text}</time></p>
  {checker.href !== null && (
    <p><a href={checker.href} class="checker-summary-link" data-checker-link>Open the checker <span aria-hidden="true">→</span></a></p>
  )}
</div>

<style>
  .checker-summary {
    display: grid;
    gap: 0.75rem;
    min-width: 0;
    max-width: 62ch;
    overflow-wrap: anywhere;
  }
  .checker-summary p {
    margin: 0;
    line-height: 1.6;
  }
  .checker-summary .checker-summary-as-at {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--color-muted);
  }
  .checker-summary-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 44px;
    font-family: var(--font-mono);
    color: var(--color-bone);
    text-decoration: underline;
    text-decoration-color: var(--color-muted);
    text-underline-offset: 3px;
  }
  .checker-summary-link:hover {
    text-decoration-color: currentColor;
    text-decoration-thickness: 2px;
  }
</style>
