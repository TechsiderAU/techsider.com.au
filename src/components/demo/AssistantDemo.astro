---
// The ② Knowledge Assistant demo in its DemoFrame (spec §8.3, §8.8, §9.1): the replay engine in
// the frame's `engine` slot and the static transcript in its `transcript` slot. The frame is badged
// as a canned replay and carries the demo's provenance. The replay plays every scenario, and starts
// when the frame scrolls into view.
// It loads the `knowledge-assistant` entry itself: the replay (DemoEngine's loader) plays
// src/data/demos/knowledge-assistant.json, so the transcript renders from the same file, and the
// build fails if that file is missing or isn't an assistant demo.
// - `level`: the scenario titles' heading level, one below the heading the demo sits under (3 under
//   a section's h2, as in the Home band).
// - `idPrefix`: starts the transcript's source ids; the default suits one ② demo per page.
import { getEntry } from "astro:content";
import DemoFrame from "../page/DemoFrame.astro";
import DemoEngine from "./DemoEngine.astro";
import AssistantTranscript from "./AssistantTranscript.astro";
import { DEMO_BADGE } from "../../lib/fixed-copy.ts";

interface Props {
  level?: 2 | 3 | 4;
  idPrefix?: string;
}

const { level = 3, idPrefix = "assistant" } = Astro.props;
const entry = await getEntry("demos", "knowledge-assistant");
if (entry === undefined) throw new Error("AssistantDemo: src/data/demos/knowledge-assistant.json is missing");
const demo = entry.data;
if (demo.kind !== "assistant") {
  throw new Error(`AssistantDemo: src/data/demos/knowledge-assistant.json is a "${demo.kind}" demo, not the assistant its replay plays`);
}
---
<DemoFrame title={demo.title} badge={DEMO_BADGE} provenance={demo.provenance}>
  <DemoEngine slot="engine" kind="assistant" />
  <AssistantTranscript slot="transcript" data={demo.data} level={level} idPrefix={idPrefix} />
</DemoFrame>
