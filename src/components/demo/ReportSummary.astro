---
// The ④ demo page's frame content (spec §8.8, §9.1): the sample report at a glance, and a link down
// to the full report in the page's #sample-report section, where SampleReport renders it. It repeats
// SampleReport's fixed caption, so no part of the report shows without it (spec §8.12), and it shows
// no result of its own. Static, with no script: the ④ demo is a report, not a replay. Every value
// comes from the report data, and the sample size is its typed `n` (spec §9.3).
import type { SampleReportData } from "../../content/schemas";

interface Props {
  report: SampleReportData;
}

const { report } = Astro.props;
---
<div class="report-summary" data-report-summary>
  <p class="report-summary-caption">Sample report: Techsider testing its own demo system, so not independent.</p>
  <dl class="report-summary-facts">
    <div>
      <dt>System tested</dt>
      <dd>{report.system}</dd>
    </div>
    <div>
      <dt>Sample size</dt>
      <dd>n = {report.n}</dd>
    </div>
    <div>
      <dt>Failures mapped to</dt>
      <dd>{report.framework}</dd>
    </div>
    <div>
      <dt>Model versions compared</dt>
      <dd>{report.regression.baseline} and {report.regression.candidate}</dd>
    </div>
  </dl>
  <p class="report-summary-more"><a href="#sample-report" class="report-summary-link">Read the sample report <span aria-hidden="true">↓</span></a></p>
</div>

<style>
  .report-summary {
    display: grid;
    gap: 1rem;
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .report-summary-caption {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    line-height: 1.5;
  }
  .report-summary-facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    gap: 1rem;
    margin: 0;
  }
  .report-summary-facts dt {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-muted);
  }
  .report-summary-facts dd {
    margin: 0.25rem 0 0;
    line-height: 1.5;
  }
  .report-summary-more {
    margin: 0;
  }
  .report-summary-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 44px;
    font-family: var(--font-mono);
    color: var(--color-bone);
    text-decoration: underline;
    text-decoration-color: var(--color-muted);
    text-underline-offset: 3px;
  }
  .report-summary-link:hover {
    text-decoration-color: currentColor;
    text-decoration-thickness: 2px;
  }
</style>
