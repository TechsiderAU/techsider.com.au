---
// The legacy Home's demo band (spec §8.1 block 4, §9.4), until Phase D Task 8 moves the Home to
// HomeTemplate and its demo slot. It now runs the ② Knowledge Assistant on the Phase D engine
// (src/components/demo/AssistantDemo.astro, which loads src/data/demos/knowledge-assistant.json);
// #demo stays, since the header's "See a demo" falls back to it while /demos/ is planned.
import AssistantDemo from "./demo/AssistantDemo.astro";
---
<section id="demo" class="legacy-demo">
  <div class="legacy-demo-inner">
    <p class="legacy-demo-eyebrow">See it work</p>
    <h2 class="legacy-demo-title">Production RAG, doing the unglamorous part.</h2>
    <p class="legacy-demo-lede">
      A scripted replay of a cited assistant answering staff questions from public documents: the passages it retrieved, answers with citations you can open, a refusal when the documents don't hold the answer, and a false answer caught by the acceptance test (not independent). It runs in your browser, with no live model.
    </p>
    <AssistantDemo level={3} />
  </div>
</section>

<style>
  /* Tokens only (the legacy aliases go in Phase D Task 8): bone text on the page's carbon. */
  .legacy-demo {
    padding: 6rem 1.5rem;
    border-bottom: 1px solid var(--color-graphite);
  }
  @media (min-width: 48rem) {
    .legacy-demo {
      padding-block: 8rem;
    }
  }
  .legacy-demo-inner {
    display: grid;
    gap: 1.5rem;
    max-width: 64rem;
    margin-inline: auto;
  }
  .legacy-demo-eyebrow {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-acid);
  }
  .legacy-demo-title {
    max-width: 26ch;
    margin: 0;
    font-size: clamp(1.875rem, 1.5rem + 1.5vw, 2.25rem);
    font-weight: 600;
    line-height: 1.15;
    color: var(--color-bone);
  }
  .legacy-demo-lede {
    max-width: 58ch;
    margin: 0;
    line-height: 1.6;
    color: var(--color-muted);
  }
</style>
